---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EnvironmentDetail from '../../../components/EnvironmentDetail.astro';
import {
  ENVIRONMENTS,
  getEnvironment,
  leadFor,
  pageTitleFor,
} from '../../../data/environments';

export function getStaticPaths() {
  return ENVIRONMENTS.map((e) => ({ params: { slug: e.slug } }));
}

const e = getEnvironment(Astro.params.slug!);
if (!e) throw new Error('missing environment');
const lead = leadFor(e, 'zh');
---
<BaseLayout
  lang="zh"
  title={pageTitleFor(e, 'zh')}
  description={lead.slice(0, 160)}
  path={`/environments/${e.slug}/`}
>
  <EnvironmentDetail lang="zh" entry={e} />
</BaseLayout>
