---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { placeholderCases, publishedCases } from '../../../data/showcase';
import { pathFor } from '../../../lib/site';
const lang = 'zh' as const;
const live = publishedCases();
const samples = placeholderCases();
---
<BaseLayout
  lang={lang}
  title="案例墙 — 公开可核验的 REA 社区案例 | rea.run"
  description="公开可核验的 REA 社区案例：来源链接、第三方注明与双语摘要。卡片结构可直接填入。"
  path="/showcase/"
>
  <div class="mx-auto max-w-5xl px-4 py-14">
    <p class="badge badge-accent">社区案例墙</p>
    <h1 class="display mt-4 text-4xl sm:text-5xl max-w-3xl">可核验的公开案例</h1>
    <p class="lede mt-4">
      每张卡片包含<strong class="text-[var(--color-ink)]">来源链接</strong>、
      <strong class="text-[var(--color-ink)]">第三方注明</strong>，以及我们改写的摘要。
      仅限授权研究——无破解／DRM 内容。
    </p>

    <div class="mt-8 grid gap-3 sm:grid-cols-3">
      <div class="card !p-4"><p class="kicker">字段</p><p class="mt-1 text-sm text-[var(--color-muted)]">id · 来源 URL · 注明 · 中英摘要 · 标签</p></div>
      <div class="card !p-4"><p class="kicker">接入</p><p class="mt-1 text-sm text-[var(--color-muted)]">在 <code>src/data/showcase.ts</code> 增加 <code>status: 'published'</code> 条目</p></div>
      <div class="card !p-4"><p class="kicker">门槛</p><p class="mt-1 text-sm text-[var(--color-muted)]">必须可公开点击，且可合法讨论</p></div>
    </div>

    {live.length > 0 && (
      <section class="mt-14">
        <p class="kicker">已发布</p>
        <h2 class="display mt-2 text-2xl">已核验条目</h2>
        <div class="mt-6 showcase-grid">
          {live.map((c) => (
            <article class="card">
              <div class="flex flex-wrap items-center gap-2">
                <span class="badge">已发布</span>
                <span class="chip">{c.date}</span>
                {c.tags.map((t) => <span class="chip">{t}</span>)}
              </div>
              <h3 class="mt-3 font-display text-2xl tracking-tight">{c.zh.title}</h3>
              <p class="mt-2 text-sm leading-7 text-[var(--color-ink-soft)]">{c.zh.summary}</p>
              <p class="mt-3 text-xs text-[var(--color-muted)]">{c.attributionZh}</p>
              <p class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
                <a class="font-semibold" href={c.source.url} rel="noopener noreferrer" target="_blank">
                  来源{c.source.handle ? ` · ${c.source.handle}` : ''} →
                </a>
                {c.secondary && (
                  <a href={c.secondary.url} rel="noopener noreferrer" target="_blank">{c.secondary.label} →</a>
                )}
              </p>
            </article>
          ))}
        </div>
      </section>
    )}

{samples.length > 0 && (
    <section class="mt-14">
      <p class="kicker">格式样例</p>
      <h2 class="display mt-2 text-2xl">占位卡——不是真实报告</h2>
      <p class="mt-2 text-sm text-[var(--color-muted)] max-w-2xl">
        仅展示版式。PM 经 executor 提供候选后，改为 <code>published</code> 并填入真实 URL。
      </p>
      <div class="mt-6 grid gap-4">
        {samples.map((c) => (
          <article class="card border-dashed opacity-95">
            <div class="flex flex-wrap items-center gap-2">
              <span class="badge">格式样例</span>
              <span class="chip">{c.date}</span>
              {c.tags.map((t) => <span class="chip">{t}</span>)}
            </div>
            <h3 class="mt-3 font-display text-xl tracking-tight text-[var(--color-ink-soft)]">{c.zh.title}</h3>
            <p class="mt-2 text-sm leading-7 text-[var(--color-muted)]">{c.zh.summary}</p>
            <p class="mt-3 text-xs font-mono text-[var(--color-accent)]">{c.attributionZh}</p>
            <p class="mt-3 text-sm">
              <a href={c.source.url} rel="noopener noreferrer" target="_blank">{c.source.label}</a>
              <span class="text-[var(--color-muted)]"> · 待替换 URL</span>
            </p>
          </article>
        ))}
      </div>
    </section>

)}

    <section class="mt-14 split-band">
      <p class="kicker !text-[#9ec0ff]">本站其它内容</p>
      <h2 class="display mt-2 text-2xl text-white">教学示例 vs 案例墙</h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-[#c5cddf]">
        <a class="text-white" href={pathFor(lang, '/examples/')}>示例</a> 是本站原创教程；
        案例墙留给核验后的<strong>外部</strong>公开记述。
      </p>
    </section>

    <p class="mt-10"><a class="quiet-link" href={pathFor(lang, '/compliance/')}>合规说明</a></p>
  </div>
</BaseLayout>
