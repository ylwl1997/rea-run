---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { publishedCases } from '../../../data/showcase';
import { pathFor } from '../../../lib/site';
const lang = 'zh' as const;
const live = publishedCases();
---
<BaseLayout
  lang={lang}
  title="案例墙 — 本站 REA 案例详述 | rea.run"
  description="卡片只打开本站详情页；脚注可引用 GitHub／主项目仓库，不以竞品文档站为主 CTA。"
  path="/showcase/"
>
  <div class="mx-auto max-w-5xl px-4 py-14">
    <p class="badge badge-accent">社区案例墙</p>
    <h1 class="display mt-4 text-4xl sm:text-5xl max-w-3xl">写在 rea.run 上的案例</h1>
    <p class="lede mt-4">
      每张卡片打开<strong class="text-[var(--color-ink)]">本站</strong>详情页，内容为原创展开。
      脚注可引用 GitHub 或主项目仓库——不以竞品文档站作为主 CTA。
    </p>

    <div class="mt-10 showcase-grid">
      {live.map((c) => (
        <a class="card no-underline hover:no-underline group" href={pathFor(lang, `/showcase/${c.id}/`)}>
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge">案例</span>
            <span class="chip">{c.date}</span>
            {c.tags.slice(0, 3).map((t) => <span class="chip">{t}</span>)}
          </div>
          <h2 class="mt-3 font-display text-xl tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">{c.zh.title}</h2>
          <p class="mt-2 text-sm leading-7 text-[var(--color-muted)]">{c.zh.summary}</p>
          <p class="mt-4 font-mono text-sm text-[var(--color-accent)]">在 rea.run 阅读 →</p>
        </a>
      ))}
    </div>

    <section class="mt-14 split-band">
      <p class="kicker !text-[#9ec0ff]">本站其它内容</p>
      <h2 class="display mt-2 text-2xl text-white">教学示例 vs 案例墙</h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-[#c5cddf]">
        <a class="text-white" href={pathFor(lang, '/examples/')}>示例</a> 是短实验；
        案例墙是更长的叙事——同样托管在本站。
      </p>
    </section>

    <p class="mt-10"><a class="quiet-link" href={pathFor(lang, '/compliance/')}>合规说明</a></p>
  </div>
</BaseLayout>
