---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { publishedCases } from '../../../data/showcase';
import { pathFor } from '../../../lib/site';
const lang = 'zh' as const;
const live = publishedCases();
---
<BaseLayout
  lang={lang}
  title="案例墙 — 本站 REA 案例与 GitHub 项目 | rea.run"
  description="本站 REA 案例与 GitHub 相关项目目录，含评价。卡片只打开站内详情页。"
  path="/showcase/"
>
  <div class="mx-auto max-w-6xl px-4 py-14">
    <header class="showcase-hero max-w-3xl">
      <p class="badge badge-accent">社区案例墙</p>
      <h1 class="display mt-4 text-4xl sm:text-5xl">案例与 GitHub 项目目录</h1>
      <p class="lede mt-4">
        杂志式目录：每张卡片打开<strong class="text-[var(--color-ink)]">本站</strong>详情页——评价、标签与合规备注都留在 rea.run。
      </p>
    </header>

    <div class="mt-12 showcase-grid">
      {live.map((c) => {
        const tone = c.relation ?? 'case-study';
        const tags = c.tags.slice(0, 4);
        return (
          <a class="showcase-card group no-underline hover:no-underline" href={pathFor(lang, `/showcase/${c.id}/`)}>
            <div class="showcase-cover" data-tone={tone}>
              <div class="showcase-cover-top">
                <span class="showcase-relation">{tone}</span>
                {c.rating ? (
                  <span class="showcase-score">{c.rating.score}/5</span>
                ) : (
                  <span class="showcase-score">{c.date}</span>
                )}
              </div>
              <h2 class="showcase-cover-title">{c.zh.title}</h2>
            </div>
            <div class="showcase-body">
              <p class="showcase-summary">{c.zh.summary}</p>
              <div class="showcase-tags">
                {tags.map((t) => <span class="chip">{t}</span>)}
              </div>
              <div class="showcase-meta-row" aria-label="来源元数据">
                <span class="chip">★ {c.github?.stars != null ? c.github.stars : '—'}</span>
                <span class="chip">{c.github?.license ?? '—'}</span>
                <span class="chip">{c.github?.updated ?? '—'}</span>
              </div>
              <div class="showcase-meta">
                <span>{c.rating ? c.rating.labelZh : '—'}</span>
                <span class="showcase-cta">阅读 →</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <section class="mt-16 split-band">
      <p class="kicker !text-[#9ec0ff]">本站其它内容</p>
      <h2 class="display mt-2 text-2xl text-white">教学示例 vs 案例墙</h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-[#c5cddf]">
        <a class="text-white" href={pathFor(lang, '/examples/')}>示例</a> 是短实验；
        案例墙是更长的叙事与 GitHub 项目介绍——同样托管在本站。
      </p>
    </section>

    <p class="mt-10"><a class="quiet-link" href={pathFor(lang, '/compliance/')}>合规说明</a></p>
  </div>
</BaseLayout>
