---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AegisClock from '../../../components/showcase/AegisClock.astro';
import { getShowcase, publishedCases } from '../../../data/showcase';
import { pathFor } from '../../../lib/site';
import { renderBody } from '../../../lib/render';

export function getStaticPaths() {
  return publishedCases().map((c) => ({ params: { slug: c.id } }));
}

const c = getShowcase(Astro.params.slug!);
if (!c || c.status !== 'published') throw new Error('missing showcase');
const html = renderBody(c.zh.body);
const others = publishedCases().filter((x) => x.id !== c.id).slice(0, 4);
const dash = '—';
const stars = c.github?.stars;
const score = c.rating?.score;
const ghUrl = c.github?.url;
---
<BaseLayout
  lang="zh"
  title={`${c.zh.title} | 案例墙 | rea.run`}
  description={c.zh.summary}
  path={`/showcase/${c.id}/`}
>
  <article class="mx-auto max-w-3xl px-4 py-14">
    <p class="text-sm">
      <a class="quiet-link" href={pathFor('zh', '/showcase/')}>← 案例墙</a>
    </p>
    <div class="mt-4 flex flex-wrap gap-2">
      <span class="badge">{c.relation ?? 'case-study'}</span>
      <span class="chip">{c.date}</span>
      {c.tags.map((t) => <span class="chip">{t}</span>)}
    </div>
    <h1 class="display mt-4 text-4xl">{c.zh.title}</h1>
    <p class="lede mt-4">{c.zh.lede}</p>

    {c.media?.video?.frame === 'portrait' && (
      <figure class="showcase-media is-portrait mt-6">
        <video
          controls
          playsinline
          preload="metadata"
          poster={c.media.video.poster}
          src={c.media.video.src}
        ></video>
        <figcaption>{c.media.video.captionZh}</figcaption>
      </figure>
    )}

    <div class="showcase-meta-panel mt-6 grid gap-4 rounded-xl border border-[var(--color-line)] bg-[var(--color-panel)] p-4 text-sm sm:grid-cols-2">
      <div class="space-y-1.5 text-[var(--color-muted)]">
        <p class="text-xs uppercase tracking-wider text-[var(--color-ink-soft)]">来源元数据</p>
        <p>
          <span class="text-[var(--color-ink)] font-semibold">{stars != null ? stars : dash}</span>
          {' '}GitHub 星标（快照）
        </p>
        <p>语言：<span class="text-[var(--color-ink)]">{c.github?.language ?? dash}</span></p>
        <p>许可：<span class="text-[var(--color-ink)]">{c.github?.license ?? dash}</span></p>
        <p>更新：<span class="text-[var(--color-ink)]">{c.github?.updated ?? dash}</span></p>
        <p class="pt-1">
          {ghUrl ? (
            <a href={ghUrl} rel="noopener noreferrer" target="_blank">GitHub 源 ↗</a>
          ) : (
            <span>GitHub 源：{dash}</span>
          )}
        </p>
      </div>
      <div class="space-y-1.5">
        <p class="text-xs uppercase tracking-wider text-[var(--color-ink-soft)]">rea.run 评价</p>
        {c.rating ? (
          <>
            <p class="font-semibold text-[var(--color-ink)]">{score}/5 — {c.rating.labelZh}</p>
            <p class="text-[var(--color-muted)]"><strong class="text-[var(--color-ink-soft)]">质量。</strong>{c.rating.qualityZh}</p>
            <p class="text-[var(--color-muted)]"><strong class="text-[var(--color-ink-soft)]">证据。</strong>{c.rating.evidenceZh}</p>
            <p class="text-[var(--color-muted)]"><strong class="text-[var(--color-ink-soft)]">局限。</strong>{c.rating.limitsZh}</p>
            <p class="text-[var(--color-muted)]"><strong class="text-[var(--color-ink-soft)]">适合。</strong>{c.rating.audienceZh}</p>
          </>
        ) : (
          <p class="text-[var(--color-muted)]">{dash}</p>
        )}
      </div>
    </div>

    {c.id === 'aegis-totp' && <AegisClock lang="zh" />}

    {c.media?.video && c.media.video.frame !== 'portrait' && (
      <figure class="showcase-media mt-8">
        <video
          controls
          playsinline
          preload="metadata"
          poster={c.media.video.poster}
          src={c.media.video.src}
        ></video>
        <figcaption>{c.media.video.captionZh}</figcaption>
      </figure>
    )}

    {c.media?.images && c.media.images.length > 0 && (
      <div class:list={['showcase-media-grid mt-8', c.media.images.length === 1 && 'is-single']}>
        {c.media.images.map((img) => (
          <figure>
            <img src={img.srcZh ?? img.src} alt={img.altZh} loading="lazy" />
            <figcaption>{img.altZh}</figcaption>
          </figure>
        ))}
      </div>
    )}

    <div class="prose-page mt-8" set:html={html} />

    {c.complianceZh && (
      <section class="mt-10 rounded-xl border border-[var(--color-line)] p-4 text-sm text-[var(--color-muted)]">
        <p class="kicker">合规</p>
        <p class="mt-2">{c.complianceZh}</p>
      </section>
    )}

    <section class="mt-10">
      <p class="kicker">要点</p>
      <ul class="mt-3 space-y-2">
        {c.zh.takeaways.map((t) => (
          <li class="rail text-sm text-[var(--color-ink-soft)]">{t}</li>
        ))}
      </ul>
    </section>

    {c.related && c.related.length > 0 && (
      <section class="mt-10">
        <p class="kicker">本站相关</p>
        <ul class="mt-3 space-y-2 text-sm">
          {c.related.map((r) => (
            <li><a href={pathFor('zh', r.href)}>{r.labelZh}</a></li>
          ))}
        </ul>
      </section>
    )}

    <footer class="mt-12 border-t border-[var(--color-line)] pt-6 text-sm text-[var(--color-muted)]">
      <p class="text-xs uppercase tracking-wider text-[var(--color-muted)]">来源说明</p>
      <p class="mt-2">{c.attributionZh}</p>
      {c.footnotes.length > 0 && (
        <ol class="mt-4 list-decimal space-y-1 pl-5 text-xs">
          {c.footnotes.map((f) => (
            <li>
              {f.url ? (
                <a href={f.url} rel="noopener noreferrer" target="_blank">{f.label}</a>
              ) : (
                f.label
              )}
            </li>
          ))}
        </ol>
      )}
      <p class="mt-4"><a class="quiet-link" href={pathFor('zh', '/compliance/')}>合规说明</a></p>
    </footer>

    {others.length > 0 && (
      <section class="mt-14">
        <p class="kicker">本站其它案例</p>
        <ul class="mt-4 space-y-3">
          {others.map((o) => (
            <li>
              <a class="font-semibold no-underline hover:underline" href={pathFor('zh', `/showcase/${o.id}/`)}>{o.zh.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
