---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { FAQ_LINKS } from '../../../data/faqIndex';
import { pathFor } from '../../../lib/site';
import { faqPageSchema } from '../../../lib/schema';
const lang = 'zh' as const;
const groups = ['P0', 'P1', 'P2'] as const;
const crumbs = [{ name: '首页', path: '/' }, { name: 'FAQ', path: '/faq/' }];
const faqSchema = faqPageSchema(
  FAQ_LINKS.map((l) => ({ question: l.zh.title, answer: l.zh.blurb })),
);
---
<BaseLayout
  lang={lang}
  title="FAQ — REA 安装、平台与边界 | rea.run"
  description="REA 中英 FAQ 枢纽：MCP 客户端矩阵、Windows／macOS Ghidra、TMPDIR 坑、能力范围、合法边界、大二进制与 Electron／ASAR、schema 体积，以及 AgentEnv 相关问答。"
  path="/faq/"
  breadcrumbs={crumbs}
  schema={faqSchema}
>
  <div class="mx-auto max-w-5xl px-4 py-14">
    <p class="badge badge-accent">FAQ</p>
    <h1 class="display mt-4 text-4xl">把 REA 跑起来的常见问题</h1>
    <p class="lede mt-4">根据上游公开议题主题原创改写。脚注可链 GitHub；不以竞品文档站为主 CTA。</p>
    {groups.map((g) => (
      <section class="mt-12">
        <p class="kicker">{g}</p>
        <div class="mt-4 grid gap-3">
          {FAQ_LINKS.filter((l) => l.priority === g).map((l) => (
            <a class="card no-underline hover:no-underline group" href={pathFor(lang, l.href)}>
              <h2 class="text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">{l.zh.title}</h2>
              <p class="mt-1 text-sm text-[var(--color-muted)]">{l.zh.blurb}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
    <p class="mt-12 text-sm"><a href={pathFor(lang, '/docs/install/')}>安装</a> · <a class="quiet-link" href={pathFor(lang, '/compliance/')}>合规</a></p>
  </div>
</BaseLayout>
