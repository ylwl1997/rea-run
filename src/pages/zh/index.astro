---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, pathFor } from '../../lib/site';
import { EXAMPLES } from '../../data/examples';
const lang = 'zh' as const;
const featured = EXAMPLES.slice(0, 2);
const agentPrompt =
  '用 npx rea-agents@latest setup 为当前智能体安装并连接 REA。先展示 setup 计划供我批准，再验证 MCP 连接。只分析我有权检查的目标。';
const puzzlePrompt =
  '用 REA 检查 /abs/path/to/our-job-runner。为什么重试等待是 1s、2s、再 4s 然后停止？给出延迟函数与上限。不要改文件。';
---
<BaseLayout
  lang={lang}
  title="rea.run — REA（Reverse Engineer Anything）中英社区指南"
  description="REA 开源 MCP/CLI 的中英双语社区文档：安装、示例、什么是逆向、对比。"
  path="/"
>
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-14">
    <div class="reveal">
      <p class="badge badge-accent mb-5">社区指南</p>
      <h1 class="display text-[clamp(2.4rem,5.5vw,3.8rem)] max-w-4xl">
        让编程智能体「看见」你有权检查的软件。
      </h1>
      <p class="lede mt-6">
        <strong class="text-[var(--color-ink)]">rea.run</strong> 是非官方中英双语站点，整理
        <strong class="text-[var(--color-ink)]">REA</strong>（Reverse Engineer Anything）的 MCP／CLI 工作流、安装说明与原创教学示例。行为以
        <a href={SITE.upstreamRepo}>GitHub 上游</a>为准。
      </p>
    </div>

    <div class="mt-10 grid gap-4 lg:grid-cols-2 reveal delay-1">
      <div class="card !bg-[var(--color-void)] !border-[#2a3144] !text-[var(--color-paper)]">
        <div class="flex items-center justify-between gap-3">
          <p class="kicker !text-[#8bb0ff]">智能体提示</p>
          <span class="pulse-dot" aria-hidden="true"></span>
        </div>
        <h2 class="mt-2 font-display text-xl text-white">粘贴到你的编程智能体</h2>
        <div class="copy-row mt-4">
          <div class="code-well !border-[#3a435c]" id="zh-home-agent-prompt">
            <span class="prompt">›</span> {agentPrompt}
          </div>
          <button type="button" class="copy-btn" data-copy="#zh-home-agent-prompt" data-copied-label="已复制">复制</button>
        </div>
      </div>
      <div class="card">
        <p class="kicker">命令行</p>
        <h2 class="mt-2 font-display text-xl">或自己跑 setup</h2>
        <div class="copy-row mt-4">
          <div class="code-well" id="zh-home-cli"><span class="dim">$</span> npx rea-agents@latest setup</div>
          <button type="button" class="copy-btn" data-copy="#zh-home-cli" data-copied-label="已复制">复制</button>
        </div>
        <div class="cta-row mt-5">
          <a class="btn" href={pathFor(lang, '/docs/install/')}>安装指南</a>
          <a class="btn-secondary" href={pathFor(lang, '/docs/install-demo/')}>Codex 跟练</a>
          <a class="btn-secondary" href={pathFor(lang, '/examples/')}>查看示例</a>
        </div>
        <div class="try-tracks" aria-label="无需本机安装的试跑路径">
          <a class="try-track" href="https://github.com/ylwl1997/rea-run-lab/actions/workflows/demo-smoke.yml" target="_blank" rel="noopener noreferrer">
            <span class="try-track-kicker">GitHub Actions</span>
            <span class="try-track-title">Actions 演示</span>
            <span class="try-track-blurb">Run workflow → 下载 Artifacts（smoke-report）。</span>
          </a>
          <a class="try-track" href="https://codespaces.new/ylwl1997/rea-run-lab?quickstart=1" target="_blank" rel="noopener noreferrer">
            <span class="try-track-kicker">Codespaces</span>
            <span class="try-track-title">用 Codespaces 试跑</span>
            <span class="try-track-blurb">Node 22 Dev Container · 仅仓内演示。</span>
          </a>
        </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-4 pt-6">
    <article class="card">
      <p class="kicker">案例墙 · 社区</p>
      <h2 class="mt-2 font-display text-2xl tracking-tight">BrOrlandi：自有小米体脂秤的智能体逆向</h2>
      <p class="mt-3 max-w-3xl text-sm leading-7 text-[var(--color-muted)]">
        @BrOrlandi 公开用编程智能体为自有体脂秤做本地看板，并开源
        <a href="https://github.com/BrOrlandi/miscale-dashboard" rel="noopener noreferrer" target="_blank">miscale-dashboard</a>。
        原帖未点名 REA。案例说明演示内容、署名链接，以及怎样安装 REA 做同类 Evidence 工作。
      </p>
      <div class="cta-row mt-5">
        <a class="btn" href={pathFor(lang, '/showcase/brorlandi-miscale/')}>阅读 BrOrlandi 案例</a>
        <a class="btn-secondary" href={pathFor(lang, '/docs/install/')}>安装 REA</a>
      </div>
    </article>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <p class="kicker">什么是逆向？</p>
    <h2 class="display mt-2 text-3xl sm:text-4xl max-w-3xl">靠阅读程序本身弄清规则——不是看宣传页。</h2>
    <p class="lede mt-4">
      原创谜题：本地任务调度失败后重试。为什么等待看起来像
      <strong class="text-[var(--color-ink)]">1 秒 → 2 秒 → 4 秒 → 停止</strong>？
    </p>

    <div class="demo-shell mt-8" data-backoff data-idle-log="点击播放，观看加速演示的指数退避。">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="kicker">退避实验室</p>
          <p class="mt-1 text-sm text-[var(--color-muted)]">观察等待节奏的微交互——不是实时 REA 会话。</p>
        </div>
        <div class="flex gap-2">
          <button type="button" class="demo-btn" data-backoff-play>播放</button>
          <button type="button" class="demo-btn ghost" data-backoff-reset>重置</button>
        </div>
      </div>
      <div class="backoff-track mt-3" data-backoff-track>
        <div class="backoff-fill" data-backoff-fill></div>
      </div>
      <div class="flex justify-between mt-2 font-mono text-[0.7rem] text-[var(--color-muted)]">
        <span>1s</span><span>2s</span><span>4s</span><span>停止</span>
      </div>
      <div class="backoff-log" data-backoff-log></div>
    </div>

    <div class="demo-shell mt-5" data-demo-tabs>
      <div class="demo-tabs" role="tablist" aria-label="之前与之后">
        <button type="button" class="demo-tab" role="tab" aria-controls="zh-panel-before" aria-selected="true">之前</button>
        <button type="button" class="demo-tab" role="tab" aria-controls="zh-panel-after" aria-selected="false">之后 · REA + 智能体</button>
      </div>
      <div class="mt-5" id="zh-panel-before" data-panel role="tabpanel">
        <div class="step-row"><span class="step-index">01</span><div><strong>找到调度器</strong><p class="mt-1 text-sm text-[var(--color-muted)]">手工翻配置与日志。</p></div></div>
        <div class="step-row"><span class="step-index">02</span><div><strong>解码延迟</strong><p class="mt-1 text-sm text-[var(--color-muted)]">线性、封顶，还是指数？</p></div></div>
        <div class="step-row"><span class="step-index">03</span><div><strong>命名停止条件</strong><p class="mt-1 text-sm text-[var(--color-muted)]">最大次数？最大延迟？两者？</p></div></div>
      </div>
      <div class="mt-5" id="zh-panel-after" data-panel role="tabpanel" hidden>
        <p class="text-sm text-[var(--color-ink-soft)] leading-7">
          用自然语言提问。REA 从你有权检查的目标返回 Evidence；智能体解释分支并引用位置。
        </p>
        <div class="copy-row mt-4">
          <div class="code-well" id="zh-puzzle-prompt"><span class="prompt">›</span> {puzzlePrompt}</div>
          <button type="button" class="copy-btn" data-copy="#zh-puzzle-prompt" data-copied-label="已复制">复制</button>
        </div>
        <p class="mt-4 text-sm">
          <a href={pathFor(lang, '/learn/what-is-reverse-engineering/')}>完整「什么是逆向」→</a>
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="kicker">示例</p>
        <h2 class="display mt-2 text-3xl">两个教学块——原创场景</h2>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="btn-secondary" href={pathFor(lang, '/examples/')}>全部示例</a>
        <a class="btn-secondary" href={pathFor(lang, '/showcase/')}>案例墙</a>
      </div>
    </div>
    <div class="mt-8 grid gap-5 lg:grid-cols-2">
      <article class="card">
        <p class="chip">{featured[0].slug}</p>
        <h3 class="mt-3 font-display text-2xl tracking-tight">{featured[0].zh.title}</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)]">{featured[0].zh.blurb}</p>
        <div class="demo-shell mt-4 !p-3 !shadow-none" data-graph-demo>
          <div class="flex items-center justify-between gap-2 mb-2">
            <p class="kicker">调用点展开</p>
            <button type="button" class="demo-btn ghost !py-1 !px-2 !text-xs" data-graph-run>重放</button>
          </div>
          <div class="graph-demo">
            <div class="graph-node" data-node><span class="font-mono text-xs text-[var(--color-accent)]">flag</span> --verbose</div>
            <div class="graph-node" data-node><span class="font-mono text-xs text-[var(--color-accent)]">parse</span> parseArgs()</div>
            <div class="graph-node" data-node><span class="font-mono text-xs text-[var(--color-accent)]">use</span> Logger.setLevel()</div>
          </div>
        </div>
        <a class="mt-5 inline-block font-semibold no-underline hover:underline" href={pathFor(lang, `/examples/${featured[0].slug}/`)}>打开示例 →</a>
      </article>
      <article class="card">
        <p class="chip">{featured[1].slug}</p>
        <h3 class="mt-3 font-display text-2xl tracking-tight">{featured[1].zh.title}</h3>
        <dl class="mt-4 space-y-3 text-sm">
          <div><dt class="kicker">目标</dt><dd class="mt-1 text-[var(--color-ink-soft)]">{featured[1].zh.goal}</dd></div>
          <div><dt class="kicker">为何要逆向</dt><dd class="mt-1 text-[var(--color-ink-soft)]">{featured[1].zh.why}</dd></div>
          <div>
            <dt class="kicker">示例提示</dt>
            <dd class="mt-2">
              <div class="copy-row">
                <div class="code-well text-[0.72rem]" id="zh-ex2-prompt">{featured[1].zh.prompt}</div>
                <button type="button" class="copy-btn" data-copy="#zh-ex2-prompt" data-copied-label="已复制">复制</button>
              </div>
            </dd>
          </div>
        </dl>
        <a class="mt-5 inline-block font-semibold no-underline hover:underline" href={pathFor(lang, `/examples/${featured[1].slug}/`)}>打开示例 →</a>
      </article>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <p class="kicker">能力分块</p>
    <h2 class="display mt-2 text-3xl max-w-2xl">按目标表面划分</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <a class="card no-underline hover:no-underline group" href={pathFor(lang, '/docs/install/#ghidra')}>
        <p class="font-mono text-xs text-[var(--color-accent)]">原生</p>
        <h3 class="mt-2 text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">自备引擎的二进制</h3>
        <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">你已有的 Ghidra／Hopper／IDA。REA 不会替你安装。</p>
      </a>
      <a class="card no-underline hover:no-underline group" href={pathFor(lang, '/examples/your-electron-export-path/')}>
        <p class="font-mono text-xs text-[var(--color-accent)]">JS · Electron</p>
        <h3 class="mt-2 text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">静态应用图</h3>
        <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">检查目录或 ASAR 类制品，通常无需原生反编译器。</p>
      </a>
      <a class="card no-underline hover:no-underline group" href={pathFor(lang, '/blog/agent-reverse-engineering-mcp/')}>
        <p class="font-mono text-xs text-[var(--color-accent)]">浏览器 · 智能体</p>
        <h3 class="mt-2 text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">MCP 工作流</h3>
        <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">编程智能体调用本地工具；人保留批准与核实。</p>
      </a>
    </div>
    <p class="mt-8">
      <a class="quiet-link" href={pathFor(lang, '/compliance/')}>合规说明</a>
    </p>
  </section>
</BaseLayout>
