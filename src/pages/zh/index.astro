---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, pathFor } from '../../lib/site';
import { BLOG_POSTS } from '../../data/blog';
import { COMPARE_PAGES } from '../../data/compare';
const lang = 'zh' as const;
---
<BaseLayout
  lang={lang}
  title="rea.run — REA（Reverse Engineer Anything）中英社区指南"
  description="REA 开源 MCP/CLI 的中英双语社区文档：安装、Ghidra、智能体逆向与对比。仅限合法授权研究。"
  path="/"
>
  <section class="relative overflow-hidden">
    <div class="hex-grid absolute inset-0 opacity-80"></div>
    <div class="relative mx-auto max-w-6xl px-4 pb-10 pt-16 sm:pt-20">
      <p class="badge mb-5">社区文档 · 仅限合法逆向</p>
      <h1 class="hero-title max-w-3xl">
        Reverse Engineer Anything —
        <span class="bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-2)] bg-clip-text text-transparent">给建造者的中英双语指南</span>
      </h1>
      <p class="hero-lede mt-6">
        面向开源 <strong class="text-[var(--color-ink)]">REA</strong> MCP/CLI：安装路径、Ghidra 接线、智能体工作流与诚实对比——摆脱通用模板感。
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a class="btn" href={pathFor(lang, '/docs/install/')}>安装指南 →</a>
        <a class="btn-secondary" href={pathFor(lang, '/compare/')}>工具对比</a>
        <a class="btn-secondary" href={SITE.upstreamRepo}>上游 GitHub</a>
      </div>
      <div class="mt-10 flex flex-wrap gap-3">
        <div class="stat-pill"><strong>中英双语</strong><span>Day1 同步</span></div>
        <div class="stat-pill"><strong>MCP + CLI</strong><span>智能体逆向</span></div>
        <div class="stat-pill"><strong>自备引擎</strong><span>Ghidra / Hopper / IDA</span></div>
        <div class="stat-pill"><strong>无 DRM 教程</strong><span>仅授权目标</span></div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-6">
    <div class="callout">
      <strong>合规。</strong>仅对你有权分析的软件使用 REA。本站不提供破解、注册机或规避 DRM 内容。见
      <a href={pathFor(lang, '/compliance/')}>合规页</a>。
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8">
    <p class="section-kicker">从这里开始</p>
    <h2 class="mt-2 text-2xl font-semibold tracking-tight">三条进入 REA 的路径</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <a class="card no-underline hover:no-underline group" href={pathFor(lang, '/docs/install/')}>
        <p class="font-mono text-xs text-[var(--color-accent)]">01 · 文档</p>
        <h3 class="mt-2 text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">安装与 MCP</h3>
        <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">Node 要求、<code>rea-agents</code> setup、手动 MCP JSON、Ghidra 环境变量。</p>
      </a>
      <a class="card no-underline hover:no-underline group" href={pathFor(lang, '/blog/')}>
        <p class="font-mono text-xs text-[var(--color-accent)]">02 · 博客</p>
        <h3 class="mt-2 text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">关键术语</h3>
        <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">REA 释义、Ghidra MCP、用 MCP 做智能体逆向。</p>
      </a>
      <a class="card no-underline hover:no-underline group" href={pathFor(lang, '/compare/')}>
        <p class="font-mono text-xs text-[var(--color-accent)]">03 · 对比</p>
        <h3 class="mt-2 text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">REA 与工作台</h3>
        <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">REA 与 Ghidra、IDA 的关系——标注第三方，拒绝炒作。</p>
      </a>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-10 lg:grid-cols-2">
    <div>
      <p class="section-kicker">释义</p>
      <h2 class="mt-2 text-2xl font-semibold tracking-tight">最新文章</h2>
      <ul class="mt-5 space-y-3">
        {BLOG_POSTS.map((p) => (
          <li class="card !p-4">
            <a class="font-semibold text-[var(--color-ink)] no-underline hover:text-[var(--color-accent)] hover:no-underline" href={pathFor(lang, `/blog/${p.slug}/`)}>{p.zh.h1}</a>
            <p class="mt-1 text-xs font-mono text-[var(--color-muted)]">{p.date}</p>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <p class="section-kicker">定向</p>
      <h2 class="mt-2 text-2xl font-semibold tracking-tight">对比页</h2>
      <ul class="mt-5 space-y-3">
        {COMPARE_PAGES.map((p) => (
          <li class="card !p-4">
            <a class="font-semibold text-[var(--color-ink)] no-underline hover:text-[var(--color-accent)] hover:no-underline" href={pathFor(lang, `/compare/${p.slug}/`)}>{p.zh.h1}</a>
            <p class="mt-1 text-sm text-[var(--color-muted)] line-clamp-2">{p.zh.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
