---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { EXAMPLES, getExample } from '../../../data/examples';
import { pathFor } from '../../../lib/site';

export function getStaticPaths() {
  return EXAMPLES.map((e) => ({ params: { slug: e.slug } }));
}
const ex = getExample(Astro.params.slug!);
if (!ex) throw new Error('missing example');
const c = ex.zh;
const showGraph = ex.slug === 'open-source-cli-flag' || ex.slug === 'your-electron-export-path';
---
<BaseLayout lang="zh" title={`${c.title} | rea.run`} description={c.blurb} path={`/examples/${ex.slug}/`}>
  <article class="mx-auto max-w-6xl px-4 py-14">
    <div class="max-w-3xl">
      <p class="badge">实验</p>
      <h1 class="display mt-4 text-4xl">{c.title}</h1>
      <p class="lede mt-4">{c.blurb}</p>
      <p class="mt-3 text-sm text-[var(--color-muted)]">{c.note} · <a class="quiet-link" href={pathFor('zh', '/compliance/')}>合规说明</a></p>
    </div>

    <div class="mt-10 grid gap-4 lg:grid-cols-2">
      <div class="card"><p class="kicker">目标</p><p class="mt-2 text-[var(--color-ink-soft)] leading-7">{c.goal}</p></div>
      <div class="card"><p class="kicker">为何要逆向</p><p class="mt-2 text-[var(--color-ink-soft)] leading-7">{c.why}</p></div>
    </div>

    <div class="demo-shell mt-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="kicker">示例提示</p>
        <button type="button" class="copy-btn" data-copy="#zh-ex-prompt" data-copied-label="已复制">复制</button>
      </div>
      <div class="code-well mt-3" id="zh-ex-prompt"><span class="prompt">›</span> {c.prompt}</div>
    </div>

    {showGraph && (
      <div class="demo-shell mt-6" data-graph-demo>
        <div class="flex items-center justify-between gap-2">
          <div>
            <p class="kicker">Evidence 路径（示意）</p>
            <p class="mt-1 text-sm text-[var(--color-muted)]">典型检查链的交错展开。</p>
          </div>
          <button type="button" class="demo-btn ghost" data-graph-run>重放</button>
        </div>
        <div class="graph-demo mt-4">
          {ex.slug === 'open-source-cli-flag' ? (
            <>
              <div class="graph-node" data-node><span class="font-mono text-xs text-[var(--color-accent)]">flag</span> --verbose</div>
              <div class="graph-node" data-node><span class="font-mono text-xs text-[var(--color-accent)]">parse</span> parseArgs()</div>
              <div class="graph-node" data-node><span class="font-mono text-xs text-[var(--color-accent)]">use</span> Logger.setLevel()</div>
            </>
          ) : (
            <>
              <div class="graph-node" data-node><span class="font-mono text-xs text-[var(--color-accent)]">entry</span> 主进程</div>
              <div class="graph-node" data-node><span class="font-mono text-xs text-[var(--color-accent)]">mod</span> exportService</div>
              <div class="graph-node" data-node><span class="font-mono text-xs text-[var(--color-accent)]">io</span> writeCsv()</div>
            </>
          )}
        </div>
      </div>
    )}

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <div class="card"><p class="kicker">返回通道</p><p class="mt-2 text-sm leading-7 text-[var(--color-ink-soft)]">REA 把 Evidence／结构化结果返回智能体会话（MCP 或 CLI JSON）。</p></div>
      <div class="card"><p class="kicker">智能体角色</p><p class="mt-2 text-sm leading-7 text-[var(--color-ink-soft)]">解读 Evidence、解释规则、列出未知。写入仍须你批准。</p></div>
    </div>

    <h2 class="display mt-12 text-2xl">建议步骤</h2>
    <div class="mt-4 demo-shell !py-2">
      {c.steps.map((s, i) => (
        <div class="step-row">
          <span class="step-index">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <strong>{s.title}</strong>
            <p class="mt-1 text-sm text-[var(--color-muted)]">{s.body}</p>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-10 flex flex-wrap gap-3">
      <a class="btn-secondary" href={pathFor('zh', '/examples/')}>← 全部示例</a>
      <a class="btn" href={pathFor('zh', '/docs/install/')}>安装</a>
      <a class="btn-secondary" href={pathFor('zh', '/showcase/')}>案例墙</a>
    </p>
  </article>
</BaseLayout>
