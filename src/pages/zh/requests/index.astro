---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { pathFor } from '../../../lib/site';
const lang = 'zh' as const;
---
<BaseLayout
  lang={lang}
  title="需求广场 — 社区需求 | rea.run"
  description="rea.run 非官方社区公开需求列表。数据来自 GitHub Issues（label: request）。"
  path="/requests/"
>
  <div class="page-shell section-pad">
    <div class="max-w-3xl">
      <p class="badge badge-accent">需求</p>
      <h1 class="display mt-4 text-4xl sm:text-5xl">需求广场</h1>
      <p class="lede mt-4">
        本<strong>非官方</strong>社区站的公开需求——文档、演示、安装说明等。
        存为 <code>ylwl1997/rea-run</code> 上带 <code>request</code> 标签的 GitHub Issue。
      </p>
      <div class="cta-row mt-6">
        <a class="btn" href={pathFor(lang, '/requests/new/')}>提交需求</a>
        <a class="btn-secondary" href="https://github.com/ylwl1997/rea-run/labels/request" target="_blank" rel="noopener noreferrer">在 GitHub 查看</a>
      </div>
    </div>
    <div class="req-grid mt-10" data-requests-plaza></div>
  </div>
  <script src="/scripts/requests.js" defer></script>
</BaseLayout>
