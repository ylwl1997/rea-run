---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { BLOG_POSTS } from '../../../data/blog';
import { pathFor } from '../../../lib/site';
const lang = 'zh' as const;
---
<BaseLayout
  lang={lang}
  title="博客 — REA 释义 | rea.run"
  description="社区释义：什么是 REA、Ghidra MCP、用 MCP 做智能体逆向。"
  path="/blog/"
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-semibold tracking-tight">博客</h1>
    <p class="mt-3 text-[var(--color-muted)]">面向建造者的关键术语说明。改写公开上游材料——非破解指南。</p>
    <ul class="mt-8 space-y-4">
      {BLOG_POSTS.map((p) => (
        <li class="card">
          <a class="text-lg font-semibold text-[var(--color-ink)] no-underline hover:underline" href={pathFor(lang, `/blog/${p.slug}/`)}>{p.zh.h1}</a>
          <p class="mt-2 text-sm text-[var(--color-muted)]">{p.zh.description}</p>
          <p class="mt-2 text-xs text-[var(--color-muted)]">{p.date}</p>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
