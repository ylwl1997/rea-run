---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { BLOG_POSTS } from '../../../data/blog';
import { pathFor } from '../../../lib/site';
const lang = 'zh' as const;
---
<BaseLayout lang={lang} title="博客 — REA 释义 | rea.run" description="社区释义：什么是 REA、Ghidra MCP、用 MCP 做智能体逆向。" path="/blog/">
  <div class="mx-auto max-w-5xl px-4 py-12">
    <p class="section-kicker">博客</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">关键术语释义</h1>
    <p class="mt-3 max-w-2xl text-[var(--color-muted)]">改写公开上游材料——非破解指南。</p>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {BLOG_POSTS.map((p, i) => (
        <a class="card no-underline hover:no-underline group" href={pathFor(lang, `/blog/${p.slug}/`)}>
          <p class="font-mono text-xs text-[var(--color-accent)]">{String(i + 1).padStart(2, '0')} · {p.date}</p>
          <h2 class="mt-2 text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">{p.zh.h1}</h2>
          <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">{p.zh.description}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
