---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { COMPARE_PAGES, getCompare } from '../../../data/compare';
import { pathFor } from '../../../lib/site';

export function getStaticPaths() {
  return COMPARE_PAGES.map((p) => ({ params: { slug: p.slug } }));
}
const page = getCompare(Astro.params.slug!);
if (!page) throw new Error('missing compare');
const c = page.zh;
---
<BaseLayout lang="zh" title={`${c.title} | rea.run`} description={c.description} path={`/compare/${page.slug}/`}>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <p class="badge">第三方说明</p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-4xl">{c.h1}</h1>
    <p class="mt-4 max-w-3xl text-base leading-7 text-[var(--color-muted)]">{c.lede}</p>

    <div class="mt-8 grid gap-3 sm:grid-cols-2">
      <div class="card !p-4">
        <p class="section-kicker">列 A</p>
        <p class="mt-1 text-sm text-[var(--color-muted)]">下方矩阵中的 REA／rea.run 一侧。</p>
      </div>
      <div class="card !p-4">
        <p class="section-kicker">列 B</p>
        <p class="mt-1 text-sm text-[var(--color-muted)]">工作台或第三方域名——请对照现网文档核实。</p>
      </div>
    </div>

    <div class="mt-8 overflow-x-auto">
      <table class="compare-table">
        <thead>
          <tr>
            <th>主题</th>
            <th>A</th>
            <th>B</th>
          </tr>
        </thead>
        <tbody>
          {c.rows.map(([a, b, d]) => (
            <tr>
              <td>{a}</td>
              <td>{b}</td>
              <td>{d}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <ul class="prose-page mt-8 list-disc space-y-2 pl-5">
      {c.notes.map((n) => <li class="text-[var(--color-muted)]">{n}</li>)}
    </ul>

    <p class="mt-10">
      <a class="btn-secondary" href={pathFor('zh', '/compare/')}>← 全部对比</a>
    </p>
  </div>
</BaseLayout>
