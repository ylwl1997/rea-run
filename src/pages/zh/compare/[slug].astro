---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { COMPARE_PAGES, getCompare } from '../../../data/compare';

export function getStaticPaths() {
  return COMPARE_PAGES.map((p) => ({ params: { slug: p.slug } }));
}
const page = getCompare(Astro.params.slug!);
if (!page) throw new Error('missing compare');
const c = page.zh;
---
<BaseLayout lang="zh" title={`${c.title} | rea.run`} description={c.description} path={`/compare/${page.slug}/`}>
  <article class="prose-page mx-auto max-w-3xl px-4 py-12">
    <p class="badge">第三方说明</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--color-ink)]">{c.h1}</h1>
    <p class="mt-4">{c.lede}</p>
    <div class="mt-8 overflow-x-auto rounded-xl border border-[var(--color-line)]">
      <table class="w-full text-left text-sm">
        <thead class="bg-[var(--color-panel)] text-[var(--color-ink)]">
          <tr>
            <th class="px-4 py-3 font-semibold">主题</th>
            <th class="px-4 py-3 font-semibold">A</th>
            <th class="px-4 py-3 font-semibold">B</th>
          </tr>
        </thead>
        <tbody>
          {c.rows.map(([a, b, d]) => (
            <tr class="border-t border-[var(--color-line)]">
              <td class="px-4 py-3 font-medium text-[var(--color-ink)]">{a}</td>
              <td class="px-4 py-3 text-[var(--color-muted)]">{b}</td>
              <td class="px-4 py-3 text-[var(--color-muted)]">{d}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <ul class="mt-6">
      {c.notes.map((n) => <li>{n}</li>)}
    </ul>
  </article>
</BaseLayout>
