---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { COMPARE_PAGES } from '../../../data/compare';
import { pathFor } from '../../../lib/site';
const lang = 'zh' as const;
---
<BaseLayout
  lang={lang}
  title="对比 REA — 第三方说明 | rea.run"
  description="标注第三方的对照：REA 与 Ghidra、REA 与 IDA、rea.run 与 rea.tools。"
  path="/compare/"
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-semibold tracking-tight">对比</h1>
    <p class="mt-3 text-[var(--color-muted)]">仅供定向。请对照厂商与上游文档核实。非联盟营销。</p>
    <ul class="mt-8 space-y-4">
      {COMPARE_PAGES.map((p) => (
        <li class="card">
          <a class="text-lg font-semibold text-[var(--color-ink)] no-underline hover:underline" href={pathFor(lang, `/compare/${p.slug}/`)}>{p.zh.h1}</a>
          <p class="mt-2 text-sm text-[var(--color-muted)]">{p.zh.description}</p>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
