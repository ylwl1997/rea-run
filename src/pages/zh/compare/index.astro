---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { COMPARE_PAGES } from '../../../data/compare';
import { pathFor } from '../../../lib/site';
const lang = 'zh' as const;
---
<BaseLayout lang={lang} title="对比 REA — 第三方说明 | rea.run" description="标注第三方的对照：REA 与 Ghidra、REA 与 IDA、rea.run 与 rea.tools。" path="/compare/">
  <div class="mx-auto max-w-5xl px-4 py-12">
    <p class="section-kicker">对比</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">定向说明，不是排行榜</h1>
    <p class="mt-3 max-w-2xl text-[var(--color-muted)]">请对照厂商与上游 GitHub 核实。非联盟营销。</p>
    <div class="mt-8 grid gap-4">
      {COMPARE_PAGES.map((p) => (
        <a class="card no-underline hover:no-underline group flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3" href={pathFor(lang, `/compare/${p.slug}/`)}>
          <div>
            <h2 class="text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">{p.zh.h1}</h2>
            <p class="mt-1 text-sm text-[var(--color-muted)]">{p.zh.description}</p>
          </div>
          <span class="font-mono text-sm text-[var(--color-accent)]">打开 →</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
