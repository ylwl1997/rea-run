---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LifeProcessShell from '../../../components/LifeProcessShell.astro';
import { pathFor } from '../../../lib/site';
import { CONTRIBUTE_PATH, ACCEPTANCE_CHECKLIST } from '../../../data/lifeProcess';
const lang = 'zh' as const;
const moduleCtas = [
  { tag: 'signal', label: '信号图鉴 — 补一条公开源' },
  { tag: 'arch', label: '架构 — 图／边界假说' },
  { tag: 'behavior', label: '行为 — 可测试的公开信号模型' },
  { tag: 'playbook', label: '剧本 — agent + REA 工作流' },
  { tag: 'diff-prep', label: '开源差分预备 — 对照维度' },
  { tag: 'chronicle', label: '纪事 — 进程日志' },
];
---
<BaseLayout
  lang={lang}
  title="如何向生命进程投稿 | rea.run"
  description="生命进程投稿路径：选模块、GitHub 标签、验收清单；用 REA 仅公开信号观察在线服务。"
  path="/life-process/join/"
>
  <LifeProcessShell lang={lang} active="join">
    <p class="lp-hero-kicker">参加 · 投稿</p>
    <h1 class="lp-title">REA → 观察在线服务 → 投稿</h1>
    <p class="lp-lede mt-4">
      用手头任意 coding agent（Hermes、Dots、Grok Bot、Claude、Codex、Other）配合 REA。
      观察在线服务的<strong>公开</strong>表面——包括 x-algorithm 这类已有 OSS 帮忙的切片——再提交可引用工件。
      开源 ≠ 全部开放；合法观察仍然有价值。
    </p>

    <section class="lp-card mt-lp" id="contribute">
      <h2>如何投稿</h2>
      {CONTRIBUTE_PATH.map((s) => (
        <div class="mt-lp">
          <h3 class="lp-sub-title"><span class="lp-step-num">{s.step}</span>{s.zh.title}</h3>
          <p class="lp-muted">{s.zh.body}</p>
        </div>
      ))}
    </section>

    <section class="lp-card mt-lp" id="which-module">
      <h2>选哪个模块／标签？</h2>
      <ul class="lp-list">
        {moduleCtas.map((m) => (
          <li>
            <code>{m.tag}</code> — {m.label}
            {' · '}
            <a href={`${pathFor(lang, '/life-process/submissions/new/')}?module=${m.tag}`}>打开表单</a>
          </li>
        ))}
      </ul>
      <p class="lp-muted mt-lp">
        始终带父标签 <code>life-process</code>。补公开 OSS／文档等源时，优先信号图鉴（<code>signal</code>）。
      </p>
    </section>

    <section class="lp-card mt-lp" id="acceptance">
      <h2>验收清单</h2>
      <ul class="lp-check">
        {ACCEPTANCE_CHECKLIST.zh.map((item) => <li>{item}</li>)}
      </ul>
      <p class="lp-muted mt-lp">
        完整政策：<a href={pathFor(lang, '/compliance/')}>/compliance/</a>。规则：<a href={pathFor(lang, '/life-process/rules/')}>/life-process/rules/</a>。
      </p>
    </section>

    <div class="lp-card mt-lp">
      <h2>工具</h2>
      <ul class="lp-list">
        <li>Grok Bot · Dots · Claude (cld) · Codex · Hermes · Other（写明）</li>
        <li>REA — <a href={pathFor(lang, '/docs/install/')}>安装</a> · <a href={pathFor(lang, '/agents/')}>Agent 专区</a> · <a href={pathFor(lang, '/learn/what-is-reverse-engineering/')}>什么是逆向</a></li>
      </ul>
    </div>

    <div class="lp-cta-row">
      <a class="lp-btn" href={`${pathFor(lang, '/life-process/submissions/new/')}?module=signal`}>向信号图鉴投稿</a>
      <a class="lp-btn-ghost" href={`/api/auth/login?return_to=${encodeURIComponent('/zh/life-process/submissions/new/')}`}>GitHub 登录</a>
      <a class="lp-btn-ghost" href={pathFor(lang, '/life-process/modules/')}>浏览模块</a>
    </div>
  </LifeProcessShell>
</BaseLayout>
