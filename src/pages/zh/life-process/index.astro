---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LifeProcessShell from '../../../components/LifeProcessShell.astro';
import { pathFor } from '../../../lib/site';
import {
  LIFE_MODULES,
  LIFE_STAGES,
  SIGNAL_ATLAS_ENTRIES,
  SIGNAL_ATLAS_COVERAGE_PCT,
  ARCH_DIAGRAM,
} from '../../../data/lifeProcess';
const lang = 'zh' as const;
const currentStage = 'signals';
const atlasPreview = SIGNAL_ATLAS_ENTRIES.slice(0, 3);
---
<BaseLayout
  lang={lang}
  title="生命进程 — 信号图鉴与社区 REA 观察 X | rea.run"
  description="生命进程不止发布页：信号图鉴（含公开 x-algorithm）、架构假说、行为模型、投稿路径——仅公开信号。"
  path="/life-process/"
>
  <LifeProcessShell lang={lang} active="home">
    <p class="lp-hero-kicker">生命进程 · 信号图鉴已启动</p>
    <h1 class="lp-title">开源 ≠ 全部开放。继续合法观察。</h1>
    <p class="lp-lede mt-4">
      xAI 已在
      <a href="https://github.com/xai-org/x-algorithm" target="_blank" rel="noopener noreferrer">xai-org/x-algorithm</a>
      部分开源 For You 排序切片（公开 OSS 信号）。这是起点，不是整站：客户端、API、策略面与大量服务，仍值得用 REA + 任意 coding agent（Hermes、Dots、Grok Bot、Claude、Codex…）做
      <strong>已授权的公开逆向与观察</strong>。
    </p>
    <div class="lp-stages" aria-label="阶段">
      {LIFE_STAGES.map((s) => (
        <span class:list={['lp-stage', s.id === currentStage && 'is-current']}>{s.zh}</span>
      ))}
    </div>
    <div class="lp-cta-row">
      <a class="lp-btn" href={`${pathFor(lang, '/life-process/modules/')}#signal-atlas`}>打开信号图鉴</a>
      <a class="lp-btn-ghost" href={`${pathFor(lang, '/life-process/join/')}#contribute`}>如何投稿</a>
      <a class="lp-btn-ghost" href={pathFor(lang, '/compliance/')}>合规</a>
    </div>

    <div class="lp-callout">
      <strong>首屏 — 信号图鉴。</strong>
      {' '}覆盖约 {SIGNAL_ATLAS_COVERAGE_PCT}%。下列为种子行；用标签 <code>signal</code> 加深。
      每条源均标公开／已授权。禁止破解、exploit、未授权访问——见
      <a href={pathFor(lang, '/compliance/')}>/compliance/</a>。
    </div>

    <div class="lp-card mt-lp" id="signal-atlas-home">
      <div class="lp-sub-top">
        <span class="lp-chip">signal</span>
        <span class="lp-muted">信号图鉴 · 起步</span>
      </div>
      <h2 class="lp-sub-title">公开信号源（种子）</h2>
      <table class="lp-atlas-table">
        <thead>
          <tr><th>来源</th><th>说明</th><th>合规</th><th>状态</th></tr>
        </thead>
        <tbody>
          {atlasPreview.map((row) => (
            <tr>
              <td>
                {row.url ? (
                  <a href={row.url} target="_blank" rel="noopener noreferrer">{row.zh.title}</a>
                ) : (
                  row.zh.title
                )}
              </td>
              <td>{row.zh.note}</td>
              <td>{row.zh.compliance}</td>
              <td><span class="lp-status">{row.status}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="lp-cta-row">
        <a class="lp-btn" href={`${pathFor(lang, '/life-process/modules/')}#signal-atlas`}>模块页完整图鉴</a>
        <a class="lp-btn-ghost" href={`${pathFor(lang, '/life-process/submissions/new/')}?module=signal`}>投稿一条信号</a>
      </div>
    </div>

    <div class="lp-card mt-lp">
      <span class="lp-chip">arch</span>
      <h2 class="lp-sub-title">{ARCH_DIAGRAM.zh.title}</h2>
      <p class="lp-muted">{ARCH_DIAGRAM.zh.caption}</p>
      <div class="lp-diagram">
        <img src={ARCH_DIAGRAM.src} alt={ARCH_DIAGRAM.zh.title} width="960" height="520" loading="lazy" />
      </div>
      <div class="lp-cta-row">
        <a class="lp-btn-ghost" href={`${pathFor(lang, '/life-process/modules/')}#architecture`}>行为模型等</a>
        <a class="lp-btn-ghost" href={`${pathFor(lang, '/life-process/submissions/new/')}?module=arch`}>投稿架构假说</a>
      </div>
    </div>

    <div class="lp-grid cols-3 mt-lp">
      {LIFE_MODULES.filter((m) => ['signal', 'arch', 'behavior'].includes(m.id)).map((m) => (
        <a class="lp-card lp-sub-card" href={`${pathFor(lang, '/life-process/modules/')}#${m.id === 'signal' ? 'signal-atlas' : m.id === 'arch' ? 'architecture' : 'behavior'}`}>
          <span class="lp-chip">{m.tag}</span>
          <h2 class="lp-sub-title">{m.zh.title}</h2>
          <p class="lp-muted">{m.zh.blurb}</p>
        </a>
      ))}
    </div>

    <div class="lp-card mt-lp">
      <h3>硬合规</h3>
      <p class="lp-muted">
        仅公开可引用信号。禁止未授权访问、破解、exploit、窃取凭证、对非公开后端的侵入式探测。
        主 CTA 留在 rea.run——不以竞品文档作主入口。
        完整政策：<a href={pathFor(lang, '/compliance/')}>合规</a>。
      </p>
    </div>
  </LifeProcessShell>
</BaseLayout>
