---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LifeProcessShell from '../../../components/LifeProcessShell.astro';
import { pathFor } from '../../../lib/site';
import { LIFE_STAGES } from '../../../data/lifeProcess';
const lang = 'zh' as const;
---
<BaseLayout
  lang={lang}
  title="关于生命进程 — 艺术＋开放科学 REA | rea.run"
  description="生命进程的缘起、目标、艺术声明与时间线：开源前用公开可引用信号社区协作逆向／重建对 X 的理解。"
  path="/life-process/about/"
>
  <LifeProcessShell lang={lang} active="about">
    <p class="lp-hero-kicker">关于</p>
    <h1 class="lp-title">源码落地前的一场艺术行为</h1>
    <div class="lp-card mt-lp">
      <h2>缘起</h2>
      <p class="lp-muted">
        在马斯克把 X 开源之前，邀请任何人用手头任意 agent（含 Hermes、Grok Bot、Dots、Claude、Codex 等）配合 REA，
        从公开可验证信号协作「逆向／重建」理解与可复现工件。
      </p>
    </div>
    <div class="lp-card mt-lp">
      <h2>目标</h2>
      <ul class="lp-list">
        <li>把公开客户端／API 可见行为收成信号图鉴——含公开 OSS 如 <a href="https://github.com/xai-org/x-algorithm" target="_blank" rel="noopener noreferrer">xai-org/x-algorithm</a>（For You 排序部分开源；开源 ≠ 全部开放）。</li>
        <li>基于公开信号发布可证伪的架构与行为假说。</li>
        <li>分享 agent 剧本，复现 REA → 观察 → 投稿闭环。</li>
        <li>更多官方源码落地时，并排对照「社区进程」与「官方真相」——学术／艺术对照。</li>
      </ul>
    </div>
    <div class="lp-card mt-lp">
      <h2>艺术声明</h2>
      <p class="lp-muted">仪式感＋开放科学纪实，不是黑客炫技。进度、时间轴与诚实的失败日志，与「正确」的图同等重要。</p>
    </div>
    <div class="lp-card mt-lp">
      <h2>时间线</h2>
      <div class="lp-stages">
        {LIFE_STAGES.map((s) => <span class="lp-stage">{s.zh}</span>)}
      </div>
      <p class="lp-muted mt-lp">当前阶段：召集中。对照页在开源日前保持空状态。</p>
    </div>
    <div class="lp-cta-row">
      <a class="lp-btn" href={pathFor(lang, '/life-process/join/')}>如何参加</a>
      <a class="lp-btn-ghost" href={pathFor(lang, '/life-process/rules/')}>规则</a>
    </div>
  </LifeProcessShell>
</BaseLayout>
