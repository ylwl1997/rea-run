---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LifeProcessShell from '../../../components/LifeProcessShell.astro';
import { pathFor } from '../../../lib/site';
const lang = 'zh' as const;
---
<BaseLayout
  lang={lang}
  title="生命进程对照 — 开源日占位 | rea.run"
  description="生命进程开源日对照占位页。官方开源前为空状态。仅维度框架，无扫描器／exploit lab。"
  path="/life-process/compare/"
>
  <LifeProcessShell lang={lang} active="compare">
    <p class="lp-hero-kicker">对照</p>
    <h1 class="lp-title">开源日——此前为空</h1>
    <div class="lp-card lp-empty mt-lp">
      <p class="lp-muted">
        尚无并排填写。官方源码落地后，本页将承载学术／艺术对照——社区进程 vs 官方真相。
        不是扫描器，不是 exploit lab。
      </p>
      <div class="lp-cta-row" style="justify-content:center">
        <a class="lp-btn-ghost" href={pathFor(lang, '/life-process/modules/')}>先去开源差分预备</a>
        <a class="lp-btn-ghost" href={pathFor(lang, '/compliance/')}>合规</a>
      </div>
    </div>
    <div class="lp-card mt-lp">
      <h2>未来对照维度</h2>
      <table class="lp-dim-table">
        <thead>
          <tr><th>维度</th><th>社区进程</th><th>官方（待定）</th></tr>
        </thead>
        <tbody>
          <tr><td>模块／服务</td><td>—</td><td>—</td></tr>
          <tr><td>协议／API</td><td>—</td><td>—</td></tr>
          <tr><td>存储／数据流</td><td>—</td><td>—</td></tr>
          <tr><td>策略／限流</td><td>—</td><td>—</td></tr>
        </tbody>
      </table>
    </div>
  </LifeProcessShell>
</BaseLayout>
