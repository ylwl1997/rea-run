---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LifeProcessShell from '../../../components/LifeProcessShell.astro';
import { pathFor } from '../../../lib/site';
import {
  LIFE_MODULES,
  SIGNAL_ATLAS_ENTRIES,
  BEHAVIOR_MODEL_SAMPLES,
  ARCH_DIAGRAM,
  SIGNAL_ATLAS_COVERAGE_PCT,
} from '../../../data/lifeProcess';
const lang = 'zh' as const;
---
<BaseLayout
  lang={lang}
  title="生命进程模块 — 信号图鉴、架构与行为 | rea.run"
  description="信号图鉴（含公开 x-algorithm）、架构假说图、行为模型样例，以及生命进程其余模块。"
  path="/life-process/modules/"
>
  <LifeProcessShell lang={lang} active="modules">
    <p class="lp-hero-kicker">模块</p>
    <h1 class="lp-title">从信号图鉴到可证伪模型</h1>
    <p class="lp-lede mt-4">
      部分开源（如 x-algorithm）是公开信号的礼物——不是停止对其余表面做合法观察的许可。
      每个模块对应 GitHub Issue 标签。
    </p>

    <section class="lp-card mt-lp" id="signal-atlas">
      <span class="lp-chip">signal</span>
      <h2 class="lp-sub-title">信号图鉴</h2>
      <p class="lp-muted">
        汇总公开客户端／API 可见行为、协议指纹、公开配置与 <strong>公开 OSS</strong>。
        覆盖约 {SIGNAL_ATLAS_COVERAGE_PCT}%。投稿标签 <code>life-process</code> + <code>signal</code>。
      </p>
      <table class="lp-atlas-table">
        <thead>
          <tr><th>来源</th><th>类型</th><th>说明</th><th>合规标注</th><th>状态</th></tr>
        </thead>
        <tbody>
          {SIGNAL_ATLAS_ENTRIES.map((row) => (
            <tr>
              <td>
                {row.url ? (
                  <a href={row.url} target="_blank" rel="noopener noreferrer">{row.zh.title}</a>
                ) : (
                  row.zh.title
                )}
              </td>
              <td><code>{row.kind}</code></td>
              <td>{row.zh.note}</td>
              <td>{row.zh.compliance}</td>
              <td><span class="lp-status">{row.status}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="lp-callout">
        <strong>关于 x-algorithm。</strong> For You 排序切片的公开 OSS。引用请带 commit。勿当作整站 X 架构。
        合规：仅公开／已授权 — <a href={pathFor(lang, '/compliance/')}>/compliance/</a>。
      </div>
      <div class="lp-cta-row">
        <a class="lp-btn" href={`${pathFor(lang, '/life-process/submissions/new/')}?module=signal`}>向信号图鉴投稿</a>
      </div>
    </section>

    <section class="lp-card mt-lp" id="architecture">
      <span class="lp-chip">arch</span>
      <h2 class="lp-sub-title">架构假说</h2>
      <p class="lp-muted">{ARCH_DIAGRAM.zh.caption}</p>
      <div class="lp-diagram">
        <img src={ARCH_DIAGRAM.src} alt={ARCH_DIAGRAM.zh.title} width="960" height="520" loading="lazy" />
      </div>
      <p class="lp-muted mt-lp">提交更好的图：附引用，并写清如何证伪。标签 <code>arch</code>。</p>
      <div class="lp-cta-row">
        <a class="lp-btn" href={`${pathFor(lang, '/life-process/submissions/new/')}?module=arch`}>投稿架构假说</a>
      </div>
    </section>

    <section class="lp-card mt-lp" id="behavior">
      <span class="lp-chip">behavior</span>
      <h2 class="lp-sub-title">行为模型 — 种子与占位</h2>
      <p class="lp-muted">来自公开信号的可测试主张。用实测、可引用模型替换占位。</p>
      {BEHAVIOR_MODEL_SAMPLES.map((m) => (
        <div class="lp-card mt-lp" style="background:#0f1320">
          <h3 class="lp-sub-title">{m.zh.title}</h3>
          <p class="lp-muted"><strong>主张。</strong> {m.zh.claim}</p>
          <p class="lp-muted"><strong>测试。</strong> {m.zh.test}</p>
          <p class="lp-muted"><strong>局限。</strong> {m.zh.limits}</p>
        </div>
      ))}
      <div class="lp-cta-row">
        <a class="lp-btn" href={`${pathFor(lang, '/life-process/submissions/new/')}?module=behavior`}>投稿行为模型</a>
      </div>
    </section>

    <h2 class="lp-title mt-lp" style="font-size:1.6rem">全部六个模块</h2>
    <div class="lp-grid cols-2">
      {LIFE_MODULES.map((m) => (
        <div class="lp-card" id={m.id}>
          <span class="lp-chip">{m.tag}</span>
          <h3 class="lp-sub-title">{m.zh.title}</h3>
          <p class="lp-muted">{m.zh.blurb}</p>
          <div class="lp-cta-row">
            <a class="lp-btn" href={`${pathFor(lang, '/life-process/submissions/new/')}?module=${m.tag}`}>投稿到 {m.tag}</a>
          </div>
        </div>
      ))}
    </div>
  </LifeProcessShell>
</BaseLayout>
