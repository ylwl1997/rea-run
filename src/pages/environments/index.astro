---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  AGENTENV,
  agentenvBlogHref,
  CATEGORY_LABEL,
  CATEGORY_ORDER,
  CHECKLIST,
  ENVIRONMENTS,
  INDEX_FAQ,
  INDEX_INTRO,
  categoryCounts,
  formatLastModified,
  type EnvCategory,
} from '../../data/environments';
import { pathFor } from '../../lib/site';
import { itemListSchema } from '../../lib/schema';

const lang = 'en' as const;
const counts = categoryCounts();
const total = ENVIRONMENTS.length;
const datasets = ENVIRONMENTS.filter((e) => e.type === 'dataset').length;
const intro = INDEX_INTRO.en;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Environments', path: '/environments/' },
];
const listSchema = itemListSchema(
  lang,
  'REA → AgentEnv environments',
  ENVIRONMENTS.filter((e) => e.type === 'dataset').map((e) => ({
    name: e.slug,
    path: `/environments/${e.slug}/`,
  })),
);
---
<BaseLayout
  lang={lang}
  title="Environments — REA → AgentEnv replay catalog | rea.run"
  description="Community teaching mirror of 50+ REA-built AgentEnv dataset environments on Hugging Face: tools, retrieval tasks, baselines, licenses — parquet/HAR stay on HF."
  path="/environments/"
  breadcrumbs={crumbs}
  schema={listSchema}
>
  <div class="mx-auto max-w-6xl px-4 py-14">
    <header class="max-w-3xl">
      <p class="badge badge-accent">Catalog · mirror</p>
      <h1 class="display mt-4 text-4xl sm:text-5xl">{intro.h1}</h1>
      <p class="lede mt-4">{intro.lede}</p>
      <ul class="mt-4 list-disc space-y-1.5 pl-5 text-sm text-[var(--color-muted)]">
        {intro.bullets.map((b) => <li>{b}</li>)}
      </ul>
      <p class="mt-4 text-sm text-[var(--color-ink-soft)]">
        <strong class="text-[var(--color-ink)]">{datasets} dataset environments</strong>
        (+ start-here Space) in this snapshot · {total} catalog rows.
      </p>
      <p class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        <a href={AGENTENV.collection} rel="noopener noreferrer" target="_blank">HF collection ↗</a>
        <a href={AGENTENV.space} rel="noopener noreferrer" target="_blank">HF Space gallery ↗</a>
        <a href={agentenvBlogHref(lang)}>Introducing AgentEnv</a>
        <a href={pathFor(lang, '/faq/agentenv-rea/')}>What is AgentEnv + REA?</a>
      </p>
    </header>

    <section class="mt-10 rounded-xl border border-[var(--color-line)] bg-[var(--color-panel)] p-5" aria-labelledby="faq-h">
      <h2 id="faq-h" class="text-lg font-semibold text-[var(--color-ink)]">FAQ</h2>
      <dl class="mt-4 space-y-4">
        {INDEX_FAQ.map((item) => (
          <div class="border-b border-[var(--color-line)] pb-4 last:border-0 last:pb-0">
            <dt class="font-semibold text-[var(--color-ink)]">{item.q.en}</dt>
            <dd class="mt-1.5 text-sm leading-7 text-[var(--color-muted)]">{item.a.en}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-4 text-xs text-[var(--color-muted)]">
        More:{' '}
        <a class="quiet-link" href={pathFor(lang, '/faq/agentenv-hosting/')}>Hosting FAQ</a>
        {' · '}
        <a class="quiet-link" href={agentenvBlogHref(lang)}>Introducing AgentEnv</a>
      </p>
    </section>

    <section class="mt-10 rounded-xl border border-[var(--color-line)] bg-[var(--color-panel)] p-5" aria-labelledby="checklist-h">
      <h2 id="checklist-h" class="text-lg font-semibold text-[var(--color-ink)]">Authorized replay checklist</h2>
      <ol class="mt-4 grid gap-3 sm:grid-cols-3">
        {CHECKLIST.en.map((step, i) => (
          <li class="step-card !items-start">
            <span class="step-num">{i + 1}</span>
            <p class="mt-0 !text-sm text-[var(--color-muted)]">{step}</p>
          </li>
        ))}
      </ol>
      <p class="mt-4 text-xs text-[var(--color-muted)]">
        Authorized use only. <a class="quiet-link" href={pathFor(lang, '/faq/legal-boundary/')}>Legal boundary</a>
        · <a class="quiet-link" href={pathFor(lang, '/compliance/')}>Compliance</a>
      </p>
    </section>

    <section class="mt-10" aria-labelledby="cats-h">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 id="cats-h" class="text-xl font-semibold text-[var(--color-ink)]">Browse by category</h2>
          <p class="mt-1 text-sm text-[var(--color-muted)]">{total} entries · filter client-side</p>
        </div>
      </div>
      <div class="mt-4 flex flex-wrap gap-2" data-env-filters role="group" aria-label="Category filter">
        <button type="button" class="chip is-filter is-on" data-filter="all" aria-pressed="true">All ({total})</button>
        {counts.map(({ category, count }) => (
          <button
            type="button"
            class="chip is-filter"
            data-filter={category}
            aria-pressed="false"
          >
            {CATEGORY_LABEL[category].en} ({count})
          </button>
        ))}
      </div>

      <div class="mt-6 overflow-x-auto">
        <table class="compare-table" data-env-table>
          <thead>
            <tr>
              <th>Environment</th>
              <th>Category</th>
              <th>Tools / tasks</th>
              <th>Baselines</th>
              <th>License</th>
              <th>HF</th>
            </tr>
          </thead>
          <tbody>
            {ENVIRONMENTS.map((e) => {
              const tools = e.parsed.tools != null ? String(e.parsed.tools) : '—';
              const tasks = e.parsed.tasks != null ? String(e.parsed.tasks) : '—';
              const baselines =
                e.parsed.baselines.length > 0
                  ? e.parsed.baselines.map((b) => `${b.model} ${b.score}`).join(' · ')
                  : '—';
              const blurb = e.parsed.summary || e.shortDescription || e.note.slice(0, 120);
              return (
                <tr data-category={e.category}>
                  <td>
                    <a class="font-semibold no-underline hover:underline" href={pathFor(lang, `/environments/${e.slug}/`)}>
                      {e.title}
                    </a>
                    {e.type === 'space' && <span class="chip ml-2">Space</span>}
                    <p class="mt-1 max-w-md text-xs text-[var(--color-muted)]">{blurb}</p>
                  </td>
                  <td>{CATEGORY_LABEL[e.category as EnvCategory].en}</td>
                  <td class="font-mono text-xs">{tools} / {tasks}</td>
                  <td class="max-w-xs text-xs text-[var(--color-muted)]">{baselines}</td>
                  <td class="text-xs">{e.parsed.license ?? '—'}</td>
                  <td>
                    <a href={e.hfUrl} rel="noopener noreferrer" target="_blank" class="whitespace-nowrap">Open ↗</a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {CATEGORY_ORDER.filter((c) => counts.some((x) => x.category === c)).map((cat) => {
        const items = ENVIRONMENTS.filter((e) => e.category === cat);
        return (
          <div class="card !p-4">
            <p class="section-kicker">{CATEGORY_LABEL[cat].en}</p>
            <p class="mt-1 font-mono text-2xl text-[var(--color-ink)]">{items.length}</p>
            <ul class="mt-3 space-y-1 text-sm">
              {items.slice(0, 5).map((e) => (
                <li>
                  <a href={pathFor(lang, `/environments/${e.slug}/`)}>{e.title}</a>
                </li>
              ))}
              {items.length > 5 && (
                <li class="text-[var(--color-muted)]">+{items.length - 5} more</li>
              )}
            </ul>
          </div>
        );
      })}
    </section>

    <footer class="mt-14 border-t border-[var(--color-line)] pt-6 text-sm text-[var(--color-muted)]">
      <p class="text-xs uppercase tracking-wider">Attribution</p>
      <p class="mt-2 max-w-3xl">{AGENTENV.attribution}</p>
      <p class="mt-3 text-xs">
        Catalog snapshot · {formatLastModified(ENVIRONMENTS[0]?.lastModified ?? new Date().toISOString(), lang)} zone Asia/Shanghai (UTC+8) for display.
        Source collection last-touched dates vary per item.
      </p>
      <p class="mt-4">
        <a href={pathFor(lang, '/docs/install/')}>Install REA</a>
        {' · '}
        <a href={pathFor(lang, '/faq/agentenv-hosting/')}>Do you host the RL envs?</a>
      </p>
    </footer>
  </div>

  <script is:inline>
    (function () {
      var root = document.querySelector('[data-env-filters]');
      var table = document.querySelector('[data-env-table]');
      if (!root || !table) return;
      var rows = Array.prototype.slice.call(table.querySelectorAll('tbody tr'));
      var buttons = Array.prototype.slice.call(root.querySelectorAll('[data-filter]'));
      function apply(cat) {
        rows.forEach(function (row) {
          var match = cat === 'all' || row.getAttribute('data-category') === cat;
          row.hidden = !match;
        });
        buttons.forEach(function (btn) {
          var on = btn.getAttribute('data-filter') === cat;
          btn.classList.toggle('is-on', on);
          btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
      }
      root.addEventListener('click', function (ev) {
        var t = ev.target;
        if (!t || !t.getAttribute) return;
        var cat = t.getAttribute('data-filter');
        if (!cat) return;
        apply(cat);
      });
    })();
  </script>
</BaseLayout>
