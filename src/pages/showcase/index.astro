---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedCases } from '../../data/showcase';
import { pathFor } from '../../lib/site';
const lang = 'en' as const;
const live = publishedCases();
---
<BaseLayout
  lang={lang}
  title="Showcase — on-site REA case studies & GitHub projects | rea.run"
  description="Directory of on-site REA case studies and GitHub-related projects with ratings. Cards open internal pages only."
  path="/showcase/"
>
  <div class="mx-auto max-w-6xl px-4 py-14">
    <header class="showcase-hero max-w-3xl">
      <p class="badge badge-accent">Community wall</p>
      <h1 class="display mt-4 text-4xl sm:text-5xl">Case studies & GitHub projects</h1>
      <p class="lede mt-4">
        Magazine-style catalog of on-site write-ups. Every card opens an internal detail page —
        ratings, tags, and compliance notes stay on rea.run.
      </p>
    </header>

    <div class="mt-12 showcase-grid">
      {live.map((c) => {
        const tone = c.relation ?? 'case-study';
        const tags = c.tags.slice(0, 4);
        return (
          <a class="showcase-card group no-underline hover:no-underline" href={pathFor(lang, `/showcase/${c.id}/`)}>
            <div class="showcase-cover" data-tone={tone}>
              <div class="showcase-cover-top">
                <span class="showcase-relation">{tone}</span>
                {c.rating ? (
                  <span class="showcase-score">{c.rating.score}/5</span>
                ) : (
                  <span class="showcase-score">{c.date}</span>
                )}
              </div>
              <h2 class="showcase-cover-title">{c.en.title}</h2>
            </div>
            <div class="showcase-body">
              <p class="showcase-summary">{c.en.summary}</p>
              <div class="showcase-tags">
                {tags.map((t) => <span class="chip">{t}</span>)}
                {c.github?.license && <span class="chip">{c.github.license}</span>}
              </div>
              <div class="showcase-meta">
                <span>
                  {c.github?.stars != null ? `★ ${c.github.stars}` : 'on-site'}
                  {c.rating ? ` · ${c.rating.labelEn}` : ''}
                </span>
                <span class="showcase-cta">Read →</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <section class="mt-16 split-band">
      <p class="kicker !text-[#9ec0ff]">Also on rea.run</p>
      <h2 class="display mt-2 text-2xl text-white">Teaching examples vs showcase</h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-[#c5cddf]">
        <a class="text-white" href={pathFor(lang, '/examples/')}>Examples</a> are original labs.
        Showcase collects longer case narratives and GitHub project intros — still hosted here.
      </p>
    </section>

    <p class="mt-10"><a class="quiet-link" href={pathFor(lang, '/compliance/')}>Compliance</a></p>
  </div>
</BaseLayout>
