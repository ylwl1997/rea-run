---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedCases } from '../../data/showcase';
import { pathFor } from '../../lib/site';
const lang = 'en' as const;
const live = publishedCases();
---
<BaseLayout
  lang={lang}
  title="Showcase — on-site REA case studies | rea.run"
  description="On-site case studies with original write-ups. Cards open internal pages only; footnotes cite GitHub/primary repos."
  path="/showcase/"
>
  <div class="mx-auto max-w-5xl px-4 py-14">
    <p class="badge badge-accent">Community wall</p>
    <h1 class="display mt-4 text-4xl sm:text-5xl max-w-3xl">Case studies on rea.run</h1>
    <p class="lede mt-4">
      Every card opens an <strong class="text-[var(--color-ink)]">on-site</strong> detail page with our own expanded write-up.
      Footnotes may cite GitHub or primary project repos — not competitor doc CTAs.
    </p>

    <div class="mt-10 showcase-grid">
      {live.map((c) => (
        <a class="card no-underline hover:no-underline group" href={pathFor(lang, `/showcase/${c.id}/`)}>
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge">Case</span>
            <span class="chip">{c.date}</span>
            {c.tags.slice(0, 3).map((t) => <span class="chip">{t}</span>)}
          </div>
          <h2 class="mt-3 font-display text-xl tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">{c.en.title}</h2>
          <p class="mt-2 text-sm leading-7 text-[var(--color-muted)]">{c.en.summary}</p>
          <p class="mt-4 font-mono text-sm text-[var(--color-accent)]">Read on rea.run →</p>
        </a>
      ))}
    </div>

    <section class="mt-14 split-band">
      <p class="kicker !text-[#9ec0ff]">Also on rea.run</p>
      <h2 class="display mt-2 text-2xl text-white">Teaching examples vs showcase</h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-[#c5cddf]">
        <a class="text-white" href={pathFor(lang, '/examples/')}>Examples</a> are original labs.
        Showcase collects longer case narratives — still hosted here.
      </p>
    </section>

    <p class="mt-10"><a class="quiet-link" href={pathFor(lang, '/compliance/')}>Compliance</a></p>
  </div>
</BaseLayout>
