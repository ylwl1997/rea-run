---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SHOWCASE_CASES, placeholderCases, publishedCases } from '../../data/showcase';
import { pathFor } from '../../lib/site';
const lang = 'en' as const;
const live = publishedCases();
const samples = placeholderCases();
---
<BaseLayout
  lang={lang}
  title="Showcase — public REA community cases | rea.run"
  description="Public, verifiable REA community cases with source links and third-party attribution. Format-ready cards for drop-in reports."
  path="/showcase/"
>
  <div class="mx-auto max-w-5xl px-4 py-14">
    <p class="badge badge-accent">Community wall</p>
    <h1 class="display mt-4 text-4xl sm:text-5xl max-w-3xl">Public cases you can verify</h1>
    <p class="lede mt-4">
      Each card links a <strong class="text-[var(--color-ink)]">source</strong>, carries a
      <strong class="text-[var(--color-ink)]">third-party attribution</strong> label, and summarizes in our own words.
      Authorized research only — no crack or DRM material.
    </p>

    <div class="mt-8 grid gap-3 sm:grid-cols-3">
      <div class="card !p-4"><p class="kicker">Schema</p><p class="mt-1 text-sm text-[var(--color-muted)]">id · source URL · attribution · EN/ZH summary · tags</p></div>
      <div class="card !p-4"><p class="kicker">Drop-in</p><p class="mt-1 text-sm text-[var(--color-muted)]">Add objects to <code>src/data/showcase.ts</code> with <code>status: 'published'</code></p></div>
      <div class="card !p-4"><p class="kicker">Bar</p><p class="mt-1 text-sm text-[var(--color-muted)]">Must be publicly linkable and legally discussable</p></div>
    </div>

    {live.length > 0 && (
      <section class="mt-14">
        <p class="kicker">Published</p>
        <h2 class="display mt-2 text-2xl">Verified entries</h2>
        <div class="mt-6 showcase-grid">
          {live.map((c) => (
            <article class="card">
              <div class="flex flex-wrap items-center gap-2">
                <span class="badge">Published</span>
                <span class="chip">{c.date}</span>
                {c.tags.map((t) => <span class="chip">{t}</span>)}
              </div>
              <h3 class="mt-3 font-display text-2xl tracking-tight">{c.en.title}</h3>
              <p class="mt-2 text-sm leading-7 text-[var(--color-ink-soft)]">{c.en.summary}</p>
              <p class="mt-3 text-xs text-[var(--color-muted)]">{c.attributionEn}</p>
              <p class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
                <a class="font-semibold" href={c.source.url} rel="noopener noreferrer" target="_blank">
                  Source{c.source.handle ? ` · ${c.source.handle}` : ''} →
                </a>
                {c.secondary && (
                  <a href={c.secondary.url} rel="noopener noreferrer" target="_blank">{c.secondary.label} →</a>
                )}
              </p>
            </article>
          ))}
        </div>
      </section>
    )}

{samples.length > 0 && (
    <section class="mt-14">
      <p class="kicker">Format samples</p>
      <h2 class="display mt-2 text-2xl">Placeholders — not real reports</h2>
      <p class="mt-2 text-sm text-[var(--color-muted)] max-w-2xl">
        These cards show layout only. PM will supply candidate cases via executor; swap <code>status</code> to <code>published</code> and fill real URLs.
      </p>
      <div class="mt-6 grid gap-4">
        {samples.map((c) => (
          <article class="card border-dashed opacity-95">
            <div class="flex flex-wrap items-center gap-2">
              <span class="badge">Format sample</span>
              <span class="chip">{c.date}</span>
              {c.tags.map((t) => <span class="chip">{t}</span>)}
            </div>
            <h3 class="mt-3 font-display text-xl tracking-tight text-[var(--color-ink-soft)]">{c.en.title}</h3>
            <p class="mt-2 text-sm leading-7 text-[var(--color-muted)]">{c.en.summary}</p>
            <p class="mt-3 text-xs font-mono text-[var(--color-accent)]">{c.attributionEn}</p>
            <p class="mt-3 text-sm">
              <a href={c.source.url} rel="noopener noreferrer" target="_blank">{c.source.label}</a>
              <span class="text-[var(--color-muted)]"> · replace URL</span>
            </p>
          </article>
        ))}
      </div>
    </section>

)}

    <section class="mt-14 split-band">
      <p class="kicker !text-[#9ec0ff]">Also on rea.run</p>
      <h2 class="display mt-2 text-2xl text-white">Teaching examples vs showcase</h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-[#c5cddf]">
        Our <a class="text-white" href={pathFor(lang, '/examples/')}>Examples</a> are original tutorials.
        Showcase is for <em>external</em> public write-ups once verified.
      </p>
    </section>

    <p class="mt-10"><a class="quiet-link" href={pathFor(lang, '/compliance/')}>Compliance</a></p>
  </div>
</BaseLayout>
