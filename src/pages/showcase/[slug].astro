---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getShowcase, publishedCases } from '../../data/showcase';
import { pathFor } from '../../lib/site';
import { renderBody } from '../../lib/render';

export function getStaticPaths() {
  return publishedCases().map((c) => ({ params: { slug: c.id } }));
}

const c = getShowcase(Astro.params.slug!);
if (!c || c.status !== 'published') throw new Error('missing showcase');
const html = renderBody(c.en.body);
const others = publishedCases().filter((x) => x.id !== c.id).slice(0, 4);
const dash = '—';
const stars = c.github?.stars;
const score = c.rating?.score;
const ghUrl = c.github?.url;
---
<BaseLayout
  lang="en"
  title={`${c.en.title} | Showcase | rea.run`}
  description={c.en.summary}
  path={`/showcase/${c.id}/`}
>
  <article class="mx-auto max-w-3xl px-4 py-14">
    <p class="text-sm">
      <a class="quiet-link" href={pathFor('en', '/showcase/')}>← Showcase</a>
    </p>
    <div class="mt-4 flex flex-wrap gap-2">
      <span class="badge">{c.relation ?? 'case-study'}</span>
      <span class="chip">{c.date}</span>
      {c.tags.map((t) => <span class="chip">{t}</span>)}
    </div>
    <h1 class="display mt-4 text-4xl">{c.en.title}</h1>
    <p class="lede mt-4">{c.en.lede}</p>

    {c.media?.video?.frame === 'portrait' && (
      <figure class="showcase-media is-portrait mt-6">
        <video
          controls
          playsinline
          preload="metadata"
          poster={c.media.video.poster}
          src={c.media.video.src}
        ></video>
        <figcaption>{c.media.video.captionEn}</figcaption>
      </figure>
    )}

    <div class="showcase-meta-panel mt-6 grid gap-4 rounded-xl border border-[var(--color-line)] bg-[var(--color-panel)] p-4 text-sm sm:grid-cols-2">
      <div class="space-y-1.5 text-[var(--color-muted)]">
        <p class="text-xs uppercase tracking-wider text-[var(--color-ink-soft)]">Source meta</p>
        <p>
          <span class="text-[var(--color-ink)] font-semibold">{stars != null ? stars : dash}</span>
          {' '}GitHub stars (snapshot)
        </p>
        <p>Language: <span class="text-[var(--color-ink)]">{c.github?.language ?? dash}</span></p>
        <p>License: <span class="text-[var(--color-ink)]">{c.github?.license ?? dash}</span></p>
        <p>Updated: <span class="text-[var(--color-ink)]">{c.github?.updated ?? dash}</span></p>
        <p class="pt-1">
          {ghUrl ? (
            <a href={ghUrl} rel="noopener noreferrer" target="_blank">GitHub source ↗</a>
          ) : (
            <span>GitHub source: {dash}</span>
          )}
        </p>
      </div>
      <div class="space-y-1.5">
        <p class="text-xs uppercase tracking-wider text-[var(--color-ink-soft)]">rea.run rating</p>
        {c.rating ? (
          <>
            <p class="font-semibold text-[var(--color-ink)]">{score}/5 — {c.rating.labelEn}</p>
            <p class="text-[var(--color-muted)]"><strong class="text-[var(--color-ink-soft)]">Quality.</strong> {c.rating.qualityEn}</p>
            <p class="text-[var(--color-muted)]"><strong class="text-[var(--color-ink-soft)]">Evidence.</strong> {c.rating.evidenceEn}</p>
            <p class="text-[var(--color-muted)]"><strong class="text-[var(--color-ink-soft)]">Limits.</strong> {c.rating.limitsEn}</p>
            <p class="text-[var(--color-muted)]"><strong class="text-[var(--color-ink-soft)]">For.</strong> {c.rating.audienceEn}</p>
          </>
        ) : (
          <p class="text-[var(--color-muted)]">{dash}</p>
        )}
      </div>
    </div>

    {c.media?.video && c.media.video.frame !== 'portrait' && (
      <figure class="showcase-media mt-8">
        <video
          controls
          playsinline
          preload="metadata"
          poster={c.media.video.poster}
          src={c.media.video.src}
        ></video>
        <figcaption>{c.media.video.captionEn}</figcaption>
      </figure>
    )}

    {c.media?.images && c.media.images.length > 0 && (
      <div class="showcase-media-grid mt-8">
        {c.media.images.map((img) => (
          <figure>
            <img src={img.src} alt={img.altEn} loading="lazy" />
            <figcaption>{img.altEn}</figcaption>
          </figure>
        ))}
      </div>
    )}

    <div class="prose-page mt-8" set:html={html} />

    {c.complianceEn && (
      <section class="mt-10 rounded-xl border border-[var(--color-line)] p-4 text-sm text-[var(--color-muted)]">
        <p class="kicker">Compliance</p>
        <p class="mt-2">{c.complianceEn}</p>
      </section>
    )}

    <section class="mt-10">
      <p class="kicker">Takeaways</p>
      <ul class="mt-3 space-y-2">
        {c.en.takeaways.map((t) => (
          <li class="rail text-sm text-[var(--color-ink-soft)]">{t}</li>
        ))}
      </ul>
    </section>

    {c.related && c.related.length > 0 && (
      <section class="mt-10">
        <p class="kicker">Related on rea.run</p>
        <ul class="mt-3 space-y-2 text-sm">
          {c.related.map((r) => (
            <li><a href={pathFor('en', r.href)}>{r.labelEn}</a></li>
          ))}
        </ul>
      </section>
    )}

    <footer class="mt-12 border-t border-[var(--color-line)] pt-6 text-sm text-[var(--color-muted)]">
      <p class="text-xs uppercase tracking-wider text-[var(--color-muted)]">Attribution</p>
      <p class="mt-2">{c.attributionEn}</p>
      {c.footnotes.length > 0 && (
        <ol class="mt-4 list-decimal space-y-1 pl-5 text-xs">
          {c.footnotes.map((f) => (
            <li>
              {f.url ? (
                <a href={f.url} rel="noopener noreferrer" target="_blank">{f.label}</a>
              ) : (
                f.label
              )}
            </li>
          ))}
        </ol>
      )}
      <p class="mt-4"><a class="quiet-link" href={pathFor('en', '/compliance/')}>Compliance</a></p>
    </footer>

    {others.length > 0 && (
      <section class="mt-14">
        <p class="kicker">More on-site cases</p>
        <ul class="mt-4 space-y-3">
          {others.map((o) => (
            <li>
              <a class="font-semibold no-underline hover:underline" href={pathFor('en', `/showcase/${o.id}/`)}>{o.en.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
