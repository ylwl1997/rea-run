---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pathFor } from '../../lib/site';
const lang = 'en' as const;
---
<BaseLayout
  lang={lang}
  title="Request plaza — community needs | rea.run"
  description="Public community requests for the unofficial rea.run site. Backed by GitHub Issues (label: request)."
  path="/requests/"
>
  <div class="page-shell section-pad">
    <div class="max-w-3xl">
      <p class="badge badge-accent">Requests</p>
      <h1 class="display mt-4 text-4xl sm:text-5xl">Request plaza</h1>
      <p class="lede mt-4">
        Public needs for this <strong>unofficial</strong> community site — docs, demos, install notes.
        Stored as GitHub Issues labeled <code>request</code> on <code>ylwl1997/rea-run</code>.
      </p>
      <div class="cta-row mt-6">
        <a class="btn" href={pathFor(lang, '/requests/new/')}>提交需求 / Submit request</a>
        <a class="btn-secondary" href="https://github.com/ylwl1997/rea-run/labels/request" target="_blank" rel="noopener noreferrer">View on GitHub</a>
      </div>
    </div>
    <div class="req-grid mt-10" data-requests-plaza></div>
  </div>
  <script src="/scripts/requests.js" defer></script>
</BaseLayout>
