---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, pathFor } from '../lib/site';
import { EXAMPLES } from '../data/examples';
const lang = 'en' as const;
const homeCrumbs = [{ name: 'Home', path: '/' }];
const featured = EXAMPLES.slice(0, 2);
const agentPrompt =
  'Install REA for this agent with npx rea-agents@latest setup. Show the setup plan for my approval, then verify the MCP connection. Use only targets I am authorized to analyze.';
const puzzlePrompt =
  'Use REA on /abs/path/to/our-job-runner. Why do retries wait 1s, 2s, then 4s and stop? Show the delay function and limits. Do not modify files.';
---
<BaseLayout lang={lang} title={SITE.titleDefault} description={SITE.descriptionDefault} path="/" breadcrumbs={homeCrumbs}>
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-14">
    <div class="reveal">
      <p class="badge badge-accent mb-5">Community guide</p>
      <h1 class="display text-[clamp(2.6rem,6vw,4.2rem)] max-w-4xl">
        Give your coding agent eyes for software you may inspect.
      </h1>
      <p class="lede mt-6">
        <strong class="text-[var(--color-ink)]">rea.run</strong> is a bilingual community home for
        <strong class="text-[var(--color-ink)]">REA</strong> (Reverse Engineer Anything) — MCP + CLI workflows,
        install notes, and original teaching examples. Source of truth stays on
        <a href={SITE.upstreamRepo}>GitHub</a>.
      </p>
    </div>

    <div class="mt-10 grid gap-4 lg:grid-cols-2 reveal delay-1">
      <div class="card !bg-[var(--color-void)] !border-[#2a3144] !text-[var(--color-paper)]">
        <div class="flex items-center justify-between gap-3">
          <p class="kicker !text-[#8bb0ff]">Agent prompt</p>
          <span class="pulse-dot" aria-hidden="true"></span>
        </div>
        <h2 class="mt-2 font-display text-xl text-white">Paste into your coding agent</h2>
        <div class="copy-row mt-4">
          <div class="code-well !border-[#3a435c]" id="home-agent-prompt">
            <span class="prompt">›</span> {agentPrompt}
          </div>
          <button type="button" class="copy-btn" data-copy="#home-agent-prompt" data-copied-label="Copied">Copy</button>
        </div>
      </div>
      <div class="card">
        <p class="kicker">CLI</p>
        <h2 class="mt-2 font-display text-xl">Or run setup yourself</h2>
        <div class="copy-row mt-4">
          <div class="code-well" id="home-cli-prompt"><span class="dim">$</span> npx rea-agents@latest setup</div>
          <button type="button" class="copy-btn" data-copy="#home-cli-prompt" data-copied-label="Copied">Copy</button>
        </div>
        <div class="cta-row mt-5">
          <a class="btn" href={pathFor(lang, '/docs/install/')}>Install guide</a>
          <a class="btn-secondary" href={pathFor(lang, '/docs/install-demo/')}>Codex walkthrough</a>
          <a class="btn-secondary" href={pathFor(lang, '/examples/')}>See examples</a>
        </div>
        <div class="try-tracks" aria-label="Try without local install">
          <a class="try-track" href="https://github.com/ylwl1997/rea-run-lab/actions/workflows/demo-smoke.yml" target="_blank" rel="noopener noreferrer">
            <span class="try-track-kicker">GitHub Actions</span>
            <span class="try-track-title">Actions demo</span>
            <span class="try-track-blurb">Run workflow → download Artifacts (smoke-report).</span>
          </a>
          <a class="try-track" href="https://codespaces.new/ylwl1997/rea-run-lab?quickstart=1" target="_blank" rel="noopener noreferrer">
            <span class="try-track-kicker">Codespaces</span>
            <span class="try-track-title">Open lab</span>
            <span class="try-track-blurb">Node 22 Dev Container · bundled demo only.</span>
          </a>
        </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-4 pt-6" aria-labelledby="en-featured-case">
    <div class="home-featured">
      <article class="card">
        <p class="kicker">Featured case</p>
        <h2 id="en-featured-case" class="display mt-2 text-3xl tracking-tight">
          Status-bar toilet remote: REA + Codex on your own Bluetooth
        </h2>
        <p class="mt-3 max-w-3xl text-sm leading-7 text-[var(--color-muted)]">
          @thinkszyg used Codex + REA to recover a smart-toilet Bluetooth protocol from a WeChat miniprogram and built a desktop status-bar remote in about half an hour. Public demo on the author's own device — reverse only hardware you own or are authorized to analyze. Full write-up and credit are on the case page.
        </p>
        <div class="cta-row mt-5">
          <a class="btn" href={pathFor(lang, '/showcase/thinkszyg-toilet-ble/')}>Read the case</a>
          <a class="btn-secondary" href={pathFor(lang, '/docs/install/')}>Install REA</a>
        </div>
      </article>
      <figure class="home-mini-clip">
        <video
          controls
          playsinline
          preload="metadata"
          poster="/media/x-cases/thinkszyg-poster.jpg"
          src="/media/x-cases/thinkszyg-toilet.mp4"
          width="720"
          height="720"
        >
          <a href="/media/x-cases/thinkszyg-toilet.mp4">Download the video</a>
        </video>
        <figcaption>Author demo: status-bar remote flipping a toilet lid. Hosted on rea.run.</figcaption>
      </figure>
    </div>
  </section>

  <!-- What is RE + interactive backoff lab -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <p class="kicker">What is reverse engineering?</p>
    <h2 class="display mt-2 text-3xl sm:text-4xl max-w-3xl">Understand a rule by reading the program — not the brochure.</h2>
    <p class="lede mt-4">
      Original puzzle: a local job runner retries failed tasks. Why do waits look like
      <strong class="text-[var(--color-ink)]">1s → 2s → 4s → stop</strong>?
    </p>

    <div class="demo-shell mt-8" data-backoff data-idle-log="Press play to watch sped-up exponential backoff (demo timing).">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="kicker">Backoff lab</p>
          <p class="mt-1 text-sm text-[var(--color-muted)]">Micro-demo of the observed wait pattern — not a live REA session.</p>
        </div>
        <div class="flex gap-2">
          <button type="button" class="demo-btn" data-backoff-play>Play</button>
          <button type="button" class="demo-btn ghost" data-backoff-reset>Reset</button>
        </div>
      </div>
      <div class="backoff-track mt-3" data-backoff-track>
        <div class="backoff-fill" data-backoff-fill></div>
      </div>
      <div class="flex justify-between mt-2 font-mono text-[0.7rem] text-[var(--color-muted)]">
        <span>1s</span><span>2s</span><span>4s</span><span>stop</span>
      </div>
      <div class="backoff-log" data-backoff-log></div>
    </div>

    <div class="demo-shell mt-5" data-demo-tabs>
      <div class="demo-tabs" role="tablist" aria-label="Before and after">
        <button type="button" class="demo-tab" role="tab" id="tab-before" aria-controls="panel-before" aria-selected="true">Before</button>
        <button type="button" class="demo-tab" role="tab" id="tab-after" aria-controls="panel-after" aria-selected="false">After · REA + agent</button>
      </div>
      <div class="mt-5" id="panel-before" data-panel role="tabpanel">
        <div class="step-row"><span class="step-index">01</span><div><strong>Find the scheduler</strong><p class="mt-1 text-sm text-[var(--color-muted)]">Hunt config keys and log lines by hand.</p></div></div>
        <div class="step-row"><span class="step-index">02</span><div><strong>Decode the delay</strong><p class="mt-1 text-sm text-[var(--color-muted)]">Linear, capped, or exponential?</p></div></div>
        <div class="step-row"><span class="step-index">03</span><div><strong>Name the stop rule</strong><p class="mt-1 text-sm text-[var(--color-muted)]">Max attempts? Max delay? Both?</p></div></div>
      </div>
      <div class="mt-5" id="panel-after" data-panel role="tabpanel" hidden>
        <p class="text-sm text-[var(--color-ink-soft)] leading-7">
          Ask in plain language. REA returns Evidence from a target you may inspect; the agent explains the branch and cites locations.
        </p>
        <div class="copy-row mt-4">
          <div class="code-well" id="home-puzzle-prompt"><span class="prompt">›</span> {puzzlePrompt}</div>
          <button type="button" class="copy-btn" data-copy="#home-puzzle-prompt" data-copied-label="Copied">Copy</button>
        </div>
        <p class="mt-4 text-sm">
          <a href={pathFor(lang, '/learn/what-is-reverse-engineering/')}>Full What is RE guide →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Examples with graph motion on first card -->
  <section class="mx-auto max-w-6xl px-4 py-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="kicker">Examples</p>
        <h2 class="display mt-2 text-3xl">Two teaching blocks — original scenarios</h2>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="btn-secondary" href={pathFor(lang, '/examples/')}>All examples</a>
        <a class="btn-secondary" href={pathFor(lang, '/showcase/')}>Showcase</a>
      </div>
    </div>
    <div class="mt-8 grid gap-5 lg:grid-cols-2">
      <article class="card">
        <p class="chip">{featured[0].slug}</p>
        <h3 class="mt-3 font-display text-2xl tracking-tight">{featured[0].en.title}</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)]">{featured[0].en.blurb}</p>
        <div class="demo-shell mt-4 !p-3 !shadow-none" data-graph-demo>
          <div class="flex items-center justify-between gap-2 mb-2">
            <p class="kicker">Call-site reveal</p>
            <button type="button" class="demo-btn ghost !py-1 !px-2 !text-xs" data-graph-run>Replay</button>
          </div>
          <div class="graph-demo">
            <div class="graph-node" data-node><span class="font-mono text-xs text-[var(--color-accent)]">flag</span> --verbose</div>
            <div class="graph-node" data-node><span class="font-mono text-xs text-[var(--color-accent)]">parse</span> parseArgs()</div>
            <div class="graph-node" data-node><span class="font-mono text-xs text-[var(--color-accent)]">use</span> Logger.setLevel()</div>
          </div>
        </div>
        <a class="mt-5 inline-block font-semibold no-underline hover:underline" href={pathFor(lang, `/examples/${featured[0].slug}/`)}>Open example →</a>
      </article>
      <article class="card">
        <p class="chip">{featured[1].slug}</p>
        <h3 class="mt-3 font-display text-2xl tracking-tight">{featured[1].en.title}</h3>
        <dl class="mt-4 space-y-3 text-sm">
          <div><dt class="kicker">Goal</dt><dd class="mt-1 text-[var(--color-ink-soft)]">{featured[1].en.goal}</dd></div>
          <div><dt class="kicker">Why reverse engineer</dt><dd class="mt-1 text-[var(--color-ink-soft)]">{featured[1].en.why}</dd></div>
          <div>
            <dt class="kicker">Sample prompt</dt>
            <dd class="mt-2">
              <div class="copy-row">
                <div class="code-well text-[0.72rem]" id="home-ex2-prompt">{featured[1].en.prompt}</div>
                <button type="button" class="copy-btn" data-copy="#home-ex2-prompt" data-copied-label="Copied">Copy</button>
              </div>
            </dd>
          </div>
        </dl>
        <a class="mt-5 inline-block font-semibold no-underline hover:underline" href={pathFor(lang, `/examples/${featured[1].slug}/`)}>Open example →</a>
      </article>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12" aria-labelledby="home-agentenv">
    <p class="kicker">AgentEnv</p>
    <h2 id="home-agentenv" class="display mt-2 text-3xl max-w-3xl">REA captures → AgentEnv replay catalog</h2>
    <p class="lede mt-4">
      Scale Labs publishes 50+ REA-built replay environments on Hugging Face.
      rea.run mirrors the catalog for teaching — not the RL runtime.
    </p>
    <div class="cta-row mt-5">
      <a class="btn" href={pathFor(lang, '/faq/agentenv-rea/')}>What is AgentEnv + REA?</a>
      <a class="btn-secondary" href={pathFor(lang, '/environments/')}>Browse environments</a>
      <a class="btn-secondary" href={pathFor(lang, '/blog/agentenv-rea/')}>Introducing AgentEnv</a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <p class="kicker">Capabilities</p>
    <h2 class="display mt-2 text-3xl max-w-2xl">Chunked by target surface</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <a class="card no-underline hover:no-underline group" href={pathFor(lang, '/docs/install/#ghidra')}>
        <p class="font-mono text-xs text-[var(--color-accent)]">Native</p>
        <h3 class="mt-2 text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">Binaries via BYO engines</h3>
        <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">Ghidra, Hopper, or IDA you already own. REA does not install them for you.</p>
      </a>
      <a class="card no-underline hover:no-underline group" href={pathFor(lang, '/examples/your-electron-export-path/')}>
        <p class="font-mono text-xs text-[var(--color-accent)]">JS · Electron</p>
        <h3 class="mt-2 text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">Static app graphs</h3>
        <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">Inspect folders or ASAR-style artifacts without a native decompiler.</p>
      </a>
      <a class="card no-underline hover:no-underline group" href={pathFor(lang, '/blog/agent-reverse-engineering-mcp/')}>
        <p class="font-mono text-xs text-[var(--color-accent)]">Browser · agent</p>
        <h3 class="mt-2 text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">MCP-connected workflows</h3>
        <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">Coding agents call local tools; humans keep approvals and verification.</p>
      </a>
    </div>
    <p class="mt-8">
      <a class="quiet-link" href={pathFor(lang, '/compliance/')}>Compliance</a>
    </p>
  </section>
</BaseLayout>
