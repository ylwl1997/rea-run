---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BLOG_POSTS } from '../../data/blog';
import { pathFor } from '../../lib/site';
const lang = 'en' as const;
---
<BaseLayout
  lang={lang}
  title="Blog — REA explainers | rea.run"
  description="Community explainers: what REA means, Ghidra MCP, and agent reverse engineering with MCP."
  path="/blog/"
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-semibold tracking-tight">Blog</h1>
    <p class="mt-3 text-[var(--color-muted)]">Key-term explainers for builders. Paraphrase of public upstream material — not crack guides.</p>
    <ul class="mt-8 space-y-4">
      {BLOG_POSTS.map((p) => (
        <li class="card">
          <a class="text-lg font-semibold text-[var(--color-ink)] no-underline hover:underline" href={pathFor(lang, `/blog/${p.slug}/`)}>{p.en.h1}</a>
          <p class="mt-2 text-sm text-[var(--color-muted)]">{p.en.description}</p>
          <p class="mt-2 text-xs text-[var(--color-muted)]">{p.date}</p>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
