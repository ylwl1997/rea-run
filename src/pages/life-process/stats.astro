---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LifeProcessShell from '../../components/LifeProcessShell.astro';
import { SIGNAL_ATLAS_COVERAGE_PCT } from '../../data/lifeProcess';
const lang = 'en' as const;
---
<BaseLayout
  lang={lang}
  title="Life Process stats — participants & modules | rea.run"
  description="Aggregate stats from GitHub Issues labeled life-process: participants, submissions by module, agent-tool distribution, daily series."
  path="/life-process/stats/"
>
  <LifeProcessShell lang={lang} active="stats">
    <p class="lp-hero-kicker">Stats</p>
    <h1 class="lp-title">Process dashboard</h1>
    <p class="lp-lede mt-4">Aggregated from public Issues with label <code>life-process</code> on ylwl1997/rea-run.</p>
    <div class="mt-lp" data-lp-stats data-signal-coverage={SIGNAL_ATLAS_COVERAGE_PCT}></div>
  </LifeProcessShell>
  <script src="/scripts/life-process.js" defer></script>
</BaseLayout>
