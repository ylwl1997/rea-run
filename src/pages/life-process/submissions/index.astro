---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LifeProcessShell from '../../../components/LifeProcessShell.astro';
import { pathFor } from '../../../lib/site';
const lang = 'en' as const;
---
<BaseLayout
  lang={lang}
  title="Life Process submissions — community plaza | rea.run"
  description="Public Life Process submissions from GitHub Issues labeled life-process. Public citable signals only."
  path="/life-process/submissions/"
>
  <LifeProcessShell lang={lang} active="submissions">
    <p class="lp-hero-kicker">Submissions</p>
    <h1 class="lp-title">Community plaza</h1>
    <p class="lp-lede mt-4">Issues labeled <code>life-process</code> on ylwl1997/rea-run.</p>
    <div class="lp-cta-row">
      <a class="lp-btn" href={pathFor(lang, '/life-process/submissions/new/')}>New submission</a>
      <a class="lp-btn-ghost" href="https://github.com/ylwl1997/rea-run/labels/life-process" target="_blank" rel="noopener noreferrer">View on GitHub</a>
    </div>
    <div class="lp-grid cols-2 mt-lp" data-lp-plaza></div>
  </LifeProcessShell>
  <script src="/scripts/life-process.js" defer></script>
</BaseLayout>
