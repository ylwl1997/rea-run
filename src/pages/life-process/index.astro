---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LifeProcessShell from '../../components/LifeProcessShell.astro';
import { pathFor } from '../../lib/site';
import {
  LIFE_MODULES,
  LIFE_STAGES,
  SIGNAL_ATLAS_ENTRIES,
  SIGNAL_ATLAS_COVERAGE_PCT,
  ARCH_DIAGRAM,
} from '../../data/lifeProcess';
const lang = 'en' as const;
const currentStage = 'signals';
const atlasPreview = SIGNAL_ATLAS_ENTRIES.slice(0, 3);
---
<BaseLayout
  lang={lang}
  title="Life Process — Signal Atlas & community REA of X | rea.run"
  description="Life Process beyond a launch page: Signal Atlas (incl. public x-algorithm), architecture hypotheses, behavior models, and how to contribute — public signals only."
  path="/life-process/"
>
  <LifeProcessShell lang={lang} active="home">
    <p class="lp-hero-kicker">Life Process · Signal Atlas live</p>
    <h1 class="lp-title">Open source ≠ everything open. Keep observing — legally.</h1>
    <p class="lp-lede mt-4">
      xAI has partly open-sourced the For You ranking slice at
      <a href="https://github.com/xai-org/x-algorithm" target="_blank" rel="noopener noreferrer">xai-org/x-algorithm</a>
      (public OSS signal). That is a start, not the whole product: clients, APIs, policy surfaces, and many services still reward
      <strong>authorized public reverse-engineering and observation</strong> with REA + any coding agent (Hermes, Dots, Grok Bot, Claude, Codex, …).
    </p>
    <div class="lp-stages" aria-label="Stages">
      {LIFE_STAGES.map((s) => (
        <span class:list={['lp-stage', s.id === currentStage && 'is-current']}>{s.en}</span>
      ))}
    </div>
    <div class="lp-cta-row">
      <a class="lp-btn" href={`${pathFor(lang, '/life-process/modules/')}#signal-atlas`}>Open Signal Atlas</a>
      <a class="lp-btn-ghost" href={`${pathFor(lang, '/life-process/join/')}#contribute`}>How to contribute</a>
      <a class="lp-btn-ghost" href={pathFor(lang, '/compliance/')}>Compliance</a>
    </div>

    <div class="lp-callout">
      <strong>Above the fold — Signal Atlas.</strong>
      {' '}Coverage ~{SIGNAL_ATLAS_COVERAGE_PCT}%. Seed rows below; deepen via label <code>signal</code>.
      Every source is tagged public / authorized. No crack, exploit, or unauthorized access —
      see <a href={pathFor(lang, '/compliance/')}>/compliance/</a>.
    </div>

    <div class="lp-card mt-lp" id="signal-atlas-home">
      <div class="lp-sub-top">
        <span class="lp-chip">signal</span>
        <span class="lp-muted">Signal Atlas · starter</span>
      </div>
      <h2 class="lp-sub-title">Public signal sources (seed)</h2>
      <table class="lp-atlas-table">
        <thead>
          <tr><th>Source</th><th>Note</th><th>Compliance</th><th>Status</th></tr>
        </thead>
        <tbody>
          {atlasPreview.map((row) => (
            <tr>
              <td>
                {row.url ? (
                  <a href={row.url} target="_blank" rel="noopener noreferrer">{row.en.title}</a>
                ) : (
                  row.en.title
                )}
              </td>
              <td>{row.en.note}</td>
              <td>{row.en.compliance}</td>
              <td><span class="lp-status">{row.status}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="lp-cta-row">
        <a class="lp-btn" href={`${pathFor(lang, '/life-process/modules/')}#signal-atlas`}>Full atlas on Modules</a>
        <a class="lp-btn-ghost" href={`${pathFor(lang, '/life-process/submissions/new/')}?module=signal`}>Submit a signal</a>
      </div>
    </div>

    <div class="lp-card mt-lp">
      <span class="lp-chip">arch</span>
      <h2 class="lp-sub-title">{ARCH_DIAGRAM.en.title}</h2>
      <p class="lp-muted">{ARCH_DIAGRAM.en.caption}</p>
      <div class="lp-diagram">
        <img src={ARCH_DIAGRAM.src} alt={ARCH_DIAGRAM.en.title} width="960" height="520" loading="lazy" />
      </div>
      <div class="lp-cta-row">
        <a class="lp-btn-ghost" href={`${pathFor(lang, '/life-process/modules/')}#architecture`}>Behavior models &amp; more</a>
        <a class="lp-btn-ghost" href={`${pathFor(lang, '/life-process/submissions/new/')}?module=arch`}>Submit an arch hypothesis</a>
      </div>
    </div>

    <div class="lp-grid cols-3 mt-lp">
      {LIFE_MODULES.filter((m) => ['signal', 'arch', 'behavior'].includes(m.id)).map((m) => (
        <a class="lp-card lp-sub-card" href={`${pathFor(lang, '/life-process/modules/')}#${m.id === 'signal' ? 'signal-atlas' : m.id === 'arch' ? 'architecture' : 'behavior'}`}>
          <span class="lp-chip">{m.tag}</span>
          <h2 class="lp-sub-title">{m.en.title}</h2>
          <p class="lp-muted">{m.en.blurb}</p>
        </a>
      ))}
    </div>

    <div class="lp-card mt-lp">
      <h3>Hard compliance</h3>
      <p class="lp-muted">
        Public citable signals only. No unauthorized access, crack, exploit, credential theft, or intrusive probing of non-public backends.
        Primary CTAs stay on rea.run — not competitor docs as the main path.
        Full policy: <a href={pathFor(lang, '/compliance/')}>compliance</a>.
      </p>
    </div>
  </LifeProcessShell>
</BaseLayout>
