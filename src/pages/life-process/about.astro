---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LifeProcessShell from '../../components/LifeProcessShell.astro';
import { pathFor } from '../../lib/site';
import { LIFE_STAGES } from '../../data/lifeProcess';
const lang = 'en' as const;
---
<BaseLayout
  lang={lang}
  title="About Life Process — art + open science REA | rea.run"
  description="Origin, goals, art statement, and timeline for Life Process: community reverse engineering of X from public signals before open source."
  path="/life-process/about/"
>
  <LifeProcessShell lang={lang} active="about">
    <p class="lp-hero-kicker">About</p>
    <h1 class="lp-title">An art behavior before the source lands</h1>
    <div class="lp-card mt-lp">
      <h2>Origin</h2>
      <p class="lp-muted">
        Before Musk open-sources X, anyone can join — with any coding agent they already use (Hermes, Grok Bot, Dots, Claude, Codex, and more) —
        and REA methods, to collaboratively rebuild understanding from public, citable signals.
      </p>
    </div>
    <div class="lp-card mt-lp">
      <h2>Goals</h2>
      <ul class="lp-list">
        <li>Catalog public client/API-visible behavior into a Signal Atlas — including public OSS such as <a href="https://github.com/xai-org/x-algorithm" target="_blank" rel="noopener noreferrer">xai-org/x-algorithm</a> (partial For You ranking; open source ≠ everything).</li>
        <li>Publish falsifiable architecture and behavior hypotheses from public signals.</li>
        <li>Share agent playbooks so others can reproduce REA → observation → contribution loops.</li>
        <li>When more official source lands, compare community process vs official truth — academically / artistically.</li>
      </ul>
    </div>
    <div class="lp-card mt-lp">
      <h2>Art statement</h2>
      <p class="lp-muted">
        Ceremony + open science documentary — not hacker flex. Progress, timeline, and honest failure logs matter as much as “correct” diagrams.
      </p>
    </div>
    <div class="lp-card mt-lp">
      <h2>Timeline</h2>
      <div class="lp-stages">
        {LIFE_STAGES.map((s) => <span class="lp-stage">{s.en}</span>)}
      </div>
      <p class="lp-muted mt-lp">Current stage: Gathering. Compare page stays empty until open-source day.</p>
    </div>
    <div class="lp-cta-row">
      <a class="lp-btn" href={pathFor(lang, '/life-process/join/')}>How to join</a>
      <a class="lp-btn-ghost" href={pathFor(lang, '/life-process/rules/')}>Rules</a>
    </div>
  </LifeProcessShell>
</BaseLayout>
