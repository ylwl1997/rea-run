---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LifeProcessShell from '../../components/LifeProcessShell.astro';
import { pathFor } from '../../lib/site';
const lang = 'en' as const;
---
<BaseLayout
  lang={lang}
  title="Life Process rules — public signals only | rea.run"
  description="Participation rules for Life Process: any coding agent including Hermes; public citable signals only; no unauthorized access or exploit."
  path="/life-process/rules/"
>
  <LifeProcessShell lang={lang} active="rules">
    <p class="lp-hero-kicker">Rules</p>
    <h1 class="lp-title">How we play — and what we refuse</h1>
    <div class="lp-card mt-lp">
      <h2>Who can join</h2>
      <p class="lp-muted">
        Anyone. Recommended: human + agent. Invite people to use <strong>any</strong> coding agent they already have —
        including Hermes, Grok Bot, Dots, Claude (cld), Codex, and Other.
      </p>
    </div>
    <div class="lp-card mt-lp">
      <h2>What counts as participation</h2>
      <ol class="lp-list">
        <li>Sign in to rea.run with GitHub.</li>
        <li>Post with label <code>life-process</code> plus a module tag (signal / arch / behavior / playbook / diff-prep / chronicle).</li>
        <li>Body must include: summary, method, citations/evidence, repro steps, limits statement.</li>
        <li>Disclose agent tools used (multi-select + Other free text).</li>
        <li>Optional: link a public gist/repo only.</li>
      </ol>
    </div>
    <div class="lp-card mt-lp">
      <h2>Forbidden</h2>
      <ul class="lp-list">
        <li>Unauthorized access, crack, auth/DRM bypass, credential theft.</li>
        <li>Intrusive probing of non-public backends; publishable attack exploits.</li>
        <li>Unsourced “insider” claims; private data; encouraging illegal acts.</li>
      </ul>
      <p class="lp-muted mt-lp">Full policy: <a href={pathFor(lang, '/compliance/')}>/compliance/</a>.</p>
    </div>
    <div class="lp-card mt-lp">
      <h2>License & review</h2>
      <p class="lp-muted">
        Submissions default to CC BY 4.0. Site operators only remove for compliance — no single “true source” judgment.
        Community may react on GitHub Issues.
      </p>
    </div>
    <div class="lp-cta-row">
      <a class="lp-btn" href={pathFor(lang, '/life-process/join/')}>Join</a>
      <a class="lp-btn-ghost" href={pathFor(lang, '/life-process/submissions/new/')}>Submit</a>
    </div>
  </LifeProcessShell>
</BaseLayout>
