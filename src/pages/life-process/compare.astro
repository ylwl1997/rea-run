---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LifeProcessShell from '../../components/LifeProcessShell.astro';
import { pathFor } from '../../lib/site';
const lang = 'en' as const;
---
<BaseLayout
  lang={lang}
  title="Life Process compare — open-source day placeholder | rea.run"
  description="Open-source day compare placeholder for Life Process. Empty until official X open source. Framework dimensions only."
  path="/life-process/compare/"
>
  <LifeProcessShell lang={lang} active="compare">
    <p class="lp-hero-kicker">Compare</p>
    <h1 class="lp-title">Open-source day — empty until then</h1>
    <div class="lp-card lp-empty mt-lp">
      <p class="lp-muted">
        No side-by-side fill yet. When official source lands, this page will host an academic / artistic compare —
        community process vs official truth. Not a scanner. Not an exploit lab.
      </p>
      <div class="lp-cta-row" style="justify-content:center">
        <a class="lp-btn-ghost" href={pathFor(lang, '/life-process/modules/')}>Prep via Open Diff Prep</a>
        <a class="lp-btn-ghost" href={pathFor(lang, '/compliance/')}>Compliance</a>
      </div>
    </div>
    <div class="lp-card mt-lp">
      <h2>Future compare dimensions</h2>
      <table class="lp-dim-table">
        <thead>
          <tr><th>Dimension</th><th>Community process</th><th>Official (TBD)</th></tr>
        </thead>
        <tbody>
          <tr><td>Modules / services</td><td>—</td><td>—</td></tr>
          <tr><td>Protocols / APIs</td><td>—</td><td>—</td></tr>
          <tr><td>Storage / data flow</td><td>—</td><td>—</td></tr>
          <tr><td>Policy / rate limits</td><td>—</td><td>—</td></tr>
        </tbody>
      </table>
    </div>
  </LifeProcessShell>
</BaseLayout>
