---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LifeProcessShell from '../../components/LifeProcessShell.astro';
import { pathFor } from '../../lib/site';
import { CONTRIBUTE_PATH, ACCEPTANCE_CHECKLIST } from '../../data/lifeProcess';
const lang = 'en' as const;
const moduleCtas = [
  { tag: 'signal', label: 'Signal Atlas — add a public source' },
  { tag: 'arch', label: 'Architecture — diagram / boundary hypothesis' },
  { tag: 'behavior', label: 'Behavior — testable public-signal model' },
  { tag: 'playbook', label: 'Playbook — agent + REA workflow' },
  { tag: 'diff-prep', label: 'Open Diff Prep — compare dimension' },
  { tag: 'chronicle', label: 'Chronicle — process log' },
];
---
<BaseLayout
  lang={lang}
  title="How to contribute to Life Process | rea.run"
  description="Clear contribution path for Life Process: pick module, GitHub labels, acceptance checklist, REA observation of online services via public signals only."
  path="/life-process/join/"
>
  <LifeProcessShell lang={lang} active="join">
    <p class="lp-hero-kicker">Join · Contribute</p>
    <h1 class="lp-title">REA → observe online services → contribute</h1>
    <p class="lp-lede mt-4">
      Use any coding agent you already have (Hermes, Dots, Grok Bot, Claude, Codex, Other) with REA methods.
      Watch <strong>public</strong> surfaces of online services — including where OSS like x-algorithm already helps — then file a citable artifact.
      Open source ≠ everything; observation remains valuable when it stays legal.
    </p>

    <section class="lp-card mt-lp" id="contribute">
      <h2>How to contribute</h2>
      {CONTRIBUTE_PATH.map((s) => (
        <div class="mt-lp">
          <h3 class="lp-sub-title"><span class="lp-step-num">{s.step}</span>{s.en.title}</h3>
          <p class="lp-muted">{s.en.body}</p>
        </div>
      ))}
    </section>

    <section class="lp-card mt-lp" id="which-module">
      <h2>Which module / label?</h2>
      <ul class="lp-list">
        {moduleCtas.map((m) => (
          <li>
            <code>{m.tag}</code> — {m.label}
            {' · '}
            <a href={`${pathFor(lang, '/life-process/submissions/new/')}?module=${m.tag}`}>Start form</a>
          </li>
        ))}
      </ul>
      <p class="lp-muted mt-lp">
        Always include parent label <code>life-process</code>. Prefer Signal Atlas (<code>signal</code>) when adding sources such as public OSS or docs.
      </p>
    </section>

    <section class="lp-card mt-lp" id="acceptance">
      <h2>Acceptance checklist</h2>
      <ul class="lp-check">
        {ACCEPTANCE_CHECKLIST.en.map((item) => <li>{item}</li>)}
      </ul>
      <p class="lp-muted mt-lp">
        Full policy: <a href={pathFor(lang, '/compliance/')}>/compliance/</a>. Rules: <a href={pathFor(lang, '/life-process/rules/')}>/life-process/rules/</a>.
      </p>
    </section>

    <div class="lp-card mt-lp">
      <h2>Tools</h2>
      <ul class="lp-list">
        <li>Grok Bot · Dots · Claude (cld) · Codex · Hermes · Other (name it)</li>
        <li>REA — <a href={pathFor(lang, '/docs/install/')}>Install</a> · <a href={pathFor(lang, '/agents/')}>Agent zone</a> · <a href={pathFor(lang, '/learn/what-is-reverse-engineering/')}>What is RE</a></li>
      </ul>
    </div>

    <div class="lp-cta-row">
      <a class="lp-btn" href={`${pathFor(lang, '/life-process/submissions/new/')}?module=signal`}>Submit to Signal Atlas</a>
      <a class="lp-btn-ghost" href={`/api/auth/login?return_to=${encodeURIComponent('/life-process/submissions/new/')}`}>GitHub sign-in</a>
      <a class="lp-btn-ghost" href={pathFor(lang, '/life-process/modules/')}>Browse modules</a>
    </div>
  </LifeProcessShell>
</BaseLayout>
