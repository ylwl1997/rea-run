---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { EXAMPLES, getExample } from '../../data/examples';
import { pathFor } from '../../lib/site';

export function getStaticPaths() {
  return EXAMPLES.map((e) => ({ params: { slug: e.slug } }));
}
const ex = getExample(Astro.params.slug!);
if (!ex) throw new Error('missing example');
const c = ex.en;
---
<BaseLayout lang="en" title={`${c.title} | rea.run`} description={c.blurb} path={`/examples/${ex.slug}/`}>
  <article class="mx-auto max-w-3xl px-4 py-14">
    <p class="badge">Example</p>
    <h1 class="display mt-4 text-4xl">{c.title}</h1>
    <p class="lede mt-4">{c.blurb}</p>
    <div class="callout mt-6">{c.note}</div>

    <div class="mt-10 grid gap-4">
      <div class="card"><p class="kicker">Goal</p><p class="mt-2 text-[var(--color-ink-soft)]">{c.goal}</p></div>
      <div class="card"><p class="kicker">Why reverse engineer</p><p class="mt-2 text-[var(--color-ink-soft)]">{c.why}</p></div>
      <div class="card">
        <p class="kicker">Sample prompt</p>
        <div class="code-well mt-3 text-[0.78rem]">{c.prompt}</div>
      </div>
      <div class="card"><p class="kicker">Return channel</p><p class="mt-2 text-[var(--color-ink-soft)]">REA returns Evidence / structured results into the agent session (MCP tools or CLI JSON). You read citations before acting.</p></div>
      <div class="card"><p class="kicker">Agent role</p><p class="mt-2 text-[var(--color-ink-soft)]">Interpret Evidence, explain the rule, list unknowns. Writes, sends, and installs stay behind your approval.</p></div>
    </div>

    <h2 class="display mt-12 text-2xl">Suggested steps</h2>
    <div class="mt-4">
      {c.steps.map((s, i) => (
        <div class="step-row">
          <span class="step-index">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <strong>{s.title}</strong>
            <p class="mt-1 text-sm text-[var(--color-muted)]">{s.body}</p>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-10 flex flex-wrap gap-3">
      <a class="btn-secondary" href={pathFor('en', '/examples/')}>← All examples</a>
      <a class="btn" href={pathFor('en', '/docs/install/')}>Install</a>
    </p>
  </article>
</BaseLayout>
