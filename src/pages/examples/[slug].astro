---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { EXAMPLES, getExample } from '../../data/examples';
import { pathFor } from '../../lib/site';

export function getStaticPaths() {
  return EXAMPLES.map((e) => ({ params: { slug: e.slug } }));
}
const ex = getExample(Astro.params.slug!);
if (!ex) throw new Error('missing example');
const c = ex.en;
const showGraph = ex.slug === 'open-source-cli-flag' || ex.slug === 'your-electron-export-path';
---
<BaseLayout lang="en" title={`${c.title} | rea.run`} description={c.blurb} path={`/examples/${ex.slug}/`}>
  <article class="mx-auto max-w-6xl px-4 py-14">
    <div class="max-w-3xl">
      <p class="badge">Lab</p>
      <h1 class="display mt-4 text-4xl">{c.title}</h1>
      <p class="lede mt-4">{c.blurb}</p>
      <p class="mt-3 text-sm text-[var(--color-muted)]">{c.note} · <a class="quiet-link" href={pathFor('en', '/compliance/')}>Compliance</a></p>
    </div>

    <div class="mt-10 grid gap-4 lg:grid-cols-2">
      <div class="card"><p class="kicker">Goal</p><p class="mt-2 text-[var(--color-ink-soft)] leading-7">{c.goal}</p></div>
      <div class="card"><p class="kicker">Why reverse engineer</p><p class="mt-2 text-[var(--color-ink-soft)] leading-7">{c.why}</p></div>
    </div>

    <div class="demo-shell mt-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="kicker">Sample prompt</p>
        <button type="button" class="copy-btn" data-copy="#ex-prompt" data-copied-label="Copied">Copy</button>
      </div>
      <div class="code-well mt-3" id="ex-prompt"><span class="prompt">›</span> {c.prompt}</div>
    </div>

    {showGraph && (
      <div class="demo-shell mt-6" data-graph-demo>
        <div class="flex items-center justify-between gap-2">
          <div>
            <p class="kicker">Evidence path (illustrative)</p>
            <p class="mt-1 text-sm text-[var(--color-muted)]">Staggered reveal of a typical inspection chain.</p>
          </div>
          <button type="button" class="demo-btn ghost" data-graph-run>Replay</button>
        </div>
        <div class="graph-demo mt-4">
          {ex.slug === 'open-source-cli-flag' ? (
            <>
              <div class="graph-node" data-node><span class="font-mono text-xs text-[var(--color-accent)]">flag</span> --verbose</div>
              <div class="graph-node" data-node><span class="font-mono text-xs text-[var(--color-accent)]">parse</span> parseArgs()</div>
              <div class="graph-node" data-node><span class="font-mono text-xs text-[var(--color-accent)]">use</span> Logger.setLevel()</div>
            </>
          ) : (
            <>
              <div class="graph-node" data-node><span class="font-mono text-xs text-[var(--color-accent)]">entry</span> main process</div>
              <div class="graph-node" data-node><span class="font-mono text-xs text-[var(--color-accent)]">mod</span> exportService</div>
              <div class="graph-node" data-node><span class="font-mono text-xs text-[var(--color-accent)]">io</span> writeCsv()</div>
            </>
          )}
        </div>
      </div>
    )}

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <div class="card"><p class="kicker">Return channel</p><p class="mt-2 text-sm leading-7 text-[var(--color-ink-soft)]">REA returns Evidence / structured results into the agent session (MCP tools or CLI JSON).</p></div>
      <div class="card"><p class="kicker">Agent role</p><p class="mt-2 text-sm leading-7 text-[var(--color-ink-soft)]">Interpret Evidence, explain the rule, list unknowns. Writes stay behind your approval.</p></div>
    </div>

    <h2 class="display mt-12 text-2xl">Suggested steps</h2>
    <div class="mt-4 demo-shell !py-2">
      {c.steps.map((s, i) => (
        <div class="step-row">
          <span class="step-index">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <strong>{s.title}</strong>
            <p class="mt-1 text-sm text-[var(--color-muted)]">{s.body}</p>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-10 flex flex-wrap gap-3">
      <a class="btn-secondary" href={pathFor('en', '/examples/')}>← All examples</a>
      <a class="btn" href={pathFor('en', '/docs/install/')}>Install</a>
      <a class="btn-secondary" href={pathFor('en', '/showcase/')}>Showcase</a>
    </p>
  </article>
</BaseLayout>
