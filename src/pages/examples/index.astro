---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { EXAMPLES } from '../../data/examples';
import { pathFor } from '../../lib/site';
const lang = 'en' as const;
---
<BaseLayout
  lang={lang}
  title="REA examples — authorized teaching scenarios | rea.run"
  description="Original REA teaching examples with goals, prompts, and interactive reveals. Legal authorized research framing."
  path="/examples/"
>
  <div class="mx-auto max-w-6xl px-4 py-14">
    <div class="max-w-3xl">
      <p class="badge badge-accent">Examples</p>
      <h1 class="display mt-4 text-4xl sm:text-5xl">Teaching scenarios — original to rea.run</h1>
      <p class="lede mt-4">
        Each example is a short lab: goal, why reverse engineer, a paste-ready prompt, return channel, and the agent’s job.
        Not calculator or dinosaur demos from other sites.
      </p>
    </div>

    <div class="mt-10 demo-shell" data-demo-tabs>
      <div class="demo-tabs" role="tablist" aria-label="How to use these examples">
        <button type="button" class="demo-tab" role="tab" aria-controls="ex-how" aria-selected="true">How to run</button>
        <button type="button" class="demo-tab" role="tab" aria-controls="ex-scope" aria-selected="false">Scope</button>
      </div>
      <div class="mt-5 text-sm leading-7 text-[var(--color-ink-soft)]" id="ex-how" data-panel>
        Install REA, restart your agent, then paste the sample prompt with an <strong>absolute path</strong> to a target you may inspect. Ask for Evidence; approve any writes yourself.
      </div>
      <div class="mt-5 text-sm leading-7 text-[var(--color-ink-soft)]" id="ex-scope" data-panel hidden>
        Prefer software you own, maintain, or have written permission to inspect. For external public write-ups, see
        <a href={pathFor(lang, '/showcase/')}>Showcase</a>.
      </div>
    </div>

    <div class="mt-12 grid gap-5">
      {EXAMPLES.map((ex, i) => (
        <a
          class="card no-underline hover:no-underline group grid gap-4 lg:grid-cols-[auto_1fr_auto] lg:items-center"
          href={pathFor(lang, `/examples/${ex.slug}/`)}
        >
          <span class="font-mono text-sm text-[var(--color-accent)]">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h2 class="text-xl font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">{ex.en.title}</h2>
            <p class="mt-1 text-sm text-[var(--color-muted)]">{ex.en.blurb}</p>
            <p class="mt-3 text-xs text-[var(--color-muted)]"><span class="kicker !normal-case !tracking-normal">Goal · </span>{ex.en.goal}</p>
          </div>
          <span class="font-mono text-sm text-[var(--color-accent)]">Open lab →</span>
        </a>
      ))}
    </div>

    <p class="mt-12 flex flex-wrap gap-4 text-sm">
      <a href="https://github.com/ylwl1997/rea-run-lab/actions">Actions demo</a>
      <a href="https://codespaces.new/ylwl1997/rea-run-lab?quickstart=1" target="_blank" rel="noopener noreferrer">用 Codespaces 试跑 / Open lab</a>
      <a href={pathFor(lang, '/docs/install/#actions-demo')}>Install · Actions</a>
      <a href={pathFor(lang, '/docs/install/#codespaces')}>Install · Codespaces</a>
      <a href={pathFor(lang, '/learn/what-is-reverse-engineering/')}>What is RE</a>
      <a href={pathFor(lang, '/showcase/')}>Showcase</a>
      <a class="quiet-link" href={pathFor(lang, '/compliance/')}>Compliance</a>
    </p>
  </div>
</BaseLayout>
