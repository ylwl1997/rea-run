---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COMPARE_PAGES } from '../../data/compare';
import { pathFor } from '../../lib/site';
const lang = 'en' as const;
---
<BaseLayout lang={lang} title="Compare REA — third-party orientation | rea.run" description="Third-party labeled comparisons: REA vs Ghidra, REA vs IDA, and rea.run vs rea.tools." path="/compare/">
  <div class="mx-auto max-w-5xl px-4 py-12">
    <p class="section-kicker">Compare</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Orientation, not a scoreboard</h1>
    <p class="mt-3 max-w-2xl text-[var(--color-muted)]">Verify against vendor and upstream GitHub docs. Not affiliate marketing.</p>
    <div class="mt-8 grid gap-4">
      {COMPARE_PAGES.map((p) => (
        <a class="card no-underline hover:no-underline group flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3" href={pathFor(lang, `/compare/${p.slug}/`)}>
          <div>
            <h2 class="text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">{p.en.h1}</h2>
            <p class="mt-1 text-sm text-[var(--color-muted)]">{p.en.description}</p>
          </div>
          <span class="font-mono text-sm text-[var(--color-accent)]">Open →</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
