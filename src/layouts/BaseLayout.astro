---
import '../styles/global.css';
import BrandLogo from '../components/BrandLogo.astro';
import HeaderSocial from '../components/HeaderSocial.astro';
import { SITE, type Lang, pathFor, NAV } from '../lib/site';

interface Props {
  lang?: Lang;
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  /** Site-relative image path, e.g. `/media/blog/cover.jpg`. */
  image?: string;
}
const { lang = 'en', title, description, path, noindex = false, image } = Astro.props;
const imageUrl = image ? new URL(image, SITE.url).href : undefined;
const canonical = new URL(pathFor(lang, path), SITE.url).href;
const enUrl = new URL(pathFor('en', path), SITE.url).href;
const zhUrl = new URL(pathFor('zh', path), SITE.url).href;
const otherLang = lang === 'en' ? 'zh' : 'en';
const otherHref = pathFor(otherLang, path);
const isActive = (href: string) => {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href);
};
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {SITE.gscVerification && <meta name="google-site-verification" content={SITE.gscVerification} />}
    {SITE.bingVerification && <meta name="msvalidate.01" content={SITE.bingVerification} />}
    {SITE.ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id: SITE.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', ga4Id);
        </script>
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=JetBrains+Mono:wght@400;600;700&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="site-wrap min-h-screen flex flex-col">
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand-link no-underline hover:no-underline" href={pathFor(lang, '/')}>
          <BrandLogo />
        </a>

        <nav class="nav-primary" aria-label={lang === 'zh' ? '主导航' : 'Primary'}>
          {NAV.map((item) => (
            <a href={pathFor(lang, item.href)} class:list={['nav-link', isActive(item.href) && 'is-active']}>
              {lang === 'zh' ? item.labelZh : item.labelEn}
            </a>
          ))}
        </nav>

        <div class="nav-utils">
          <a href={pathFor(lang, '/compliance/')} class="nav-util quiet no-underline hover:no-underline">
            {lang === 'zh' ? '合规' : 'Compliance'}
          </a>
          <div class="lang-switch" role="group" aria-label={lang === 'zh' ? '语言' : 'Language'}>
            <a
              href={pathFor('en', path)}
              class:list={['lang-opt', lang === 'en' && 'is-on']}
              hreflang="en"
              lang="en"
            >EN</a>
            <a
              href={pathFor('zh', path)}
              class:list={['lang-opt', lang === 'zh' && 'is-on']}
              hreflang="zh-CN"
              lang="zh-CN"
            >中文</a>
          </div>
          <HeaderSocial lang={lang} />
          <div class="auth-slot" data-auth-root></div>
          <button
            type="button"
            class="nav-burger"
            aria-expanded="false"
            aria-controls="mobile-nav"
            data-nav-toggle
          >
            <span class="sr-only">{lang === 'zh' ? '打开菜单' : 'Open menu'}</span>
            <span class="burger-lines" aria-hidden="true"></span>
          </button>
        </div>
      </div>

      <div id="mobile-nav" class="nav-drawer" hidden data-nav-drawer>
        <nav class="nav-drawer-links" aria-label={lang === 'zh' ? '移动导航' : 'Mobile'}>
          {NAV.map((item) => (
            <a href={pathFor(lang, item.href)} class:list={['nav-drawer-link', isActive(item.href) && 'is-active']}>
              {lang === 'zh' ? item.labelZh : item.labelEn}
            </a>
          ))}
        </nav>
        <div class="nav-drawer-social">
          <HeaderSocial lang={lang} />
        </div>
        <div class="nav-drawer-foot">
          <div class="auth-slot" data-auth-root></div>
          <a href={pathFor(lang, '/compliance/')} class="nav-util quiet no-underline hover:no-underline">
            {lang === 'zh' ? '合规说明' : 'Compliance'}
          </a>
          <div class="lang-switch">
            <a href={pathFor('en', path)} class:list={['lang-opt', lang === 'en' && 'is-on']} hreflang="en">EN</a>
            <a href={pathFor('zh', path)} class:list={['lang-opt', lang === 'zh' && 'is-on']} hreflang="zh-CN">中文</a>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1"><slot /></main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <div>
          <div class="mb-4"><BrandLogo /></div>
          <p class="max-w-xl text-sm leading-7 text-[var(--color-ink-soft)]">
            {lang === 'zh' ? SITE.disclaimerZh : SITE.disclaimer}
          </p>
        </div>
        <div class="grid grid-cols-2 gap-4 text-sm">
          <div class="space-y-2">
            <p class="kicker">{lang === 'zh' ? '指南' : 'Guide'}</p>
            <a class="block text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-accent)]" href={pathFor(lang, '/learn/what-is-reverse-engineering/')}>{lang === 'zh' ? '什么是逆向' : 'What is RE'}</a>
            <a class="block text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-accent)]" href={pathFor(lang, '/examples/')}>{lang === 'zh' ? '示例' : 'Examples'}</a>
            <a class="block text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-accent)]" href={pathFor(lang, '/showcase/')}>{lang === 'zh' ? '案例墙' : 'Showcase'}</a>
            <a class="block text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-accent)]" href={pathFor(lang, '/environments/')}>{lang === 'zh' ? 'Environments' : 'Environments'}</a>
            <a class="block text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-accent)]" href={pathFor(lang, '/lab/')}>{lang === 'zh' ? '实验室' : 'Lab'}</a>
            <a class="block text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-accent)]" href={pathFor(lang, '/docs/install/')}>{lang === 'zh' ? '安装' : 'Install'}</a>
            <a class="block text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-accent)]" href={pathFor(lang, '/docs/clients/')}>{lang === 'zh' ? '客户端' : 'Clients'}</a>
            <a class="block text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-accent)]" href={pathFor(lang, '/docs/breaking/')}>{lang === 'zh' ? '升级注意' : 'Breaking'}</a>
            <a class="block text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-accent)]" href={pathFor(lang, '/changelog/')}>{lang === 'zh' ? '更新日志' : 'Changelog'}</a>
            <a class="block text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-accent)]" href={pathFor(lang, '/docs/install-demo/')}>{lang === 'zh' ? '安装演示' : 'Install demo'}</a>
          </div>
          <div class="space-y-2">
            <p class="kicker">{lang === 'zh' ? '上游' : 'Upstream'}</p>
            <a class="block text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-accent)]" href={SITE.upstreamRepo}>GitHub</a>
            <a class="block text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-accent)]" href={SITE.upstreamNpm}>npm rea-agents</a>
            <a class="block text-[var(--color-ink-soft)] no-underline hover:text-[var(--color-accent)]" href={pathFor(lang, '/verify/')}>{lang === 'zh' ? '搜索验证' : 'Search verify'}</a>
          </div>
        </div>
      </div>
      <div class="border-t border-[var(--color-line)]">
        <div class="mx-auto max-w-6xl px-4 py-4 text-xs leading-6 text-[var(--color-muted)]">
          <p>
            {lang === 'zh' ? SITE.agentenvAttributionZh : SITE.agentenvAttribution}
            {' '}
            <a class="text-[var(--color-ink-soft)]" href={SITE.agentenvBlog} rel="noopener noreferrer" target="_blank">AgentEnv</a>
            {' · '}
            <a class="text-[var(--color-ink-soft)]" href={SITE.agentenvSpace} rel="noopener noreferrer" target="_blank">HF Space</a>
            {' · '}
            <a class="text-[var(--color-ink-soft)]" href={pathFor(lang, '/environments/')}>Environments</a>
          </p>
          <p class="mt-2 font-mono">© {new Date().getFullYear()} rea.run community</p>
        </div>
      </div>
    </footer>
      <script src="/scripts/demos.js" defer></script>
      <script src="/scripts/auth.js" defer></script>
      <script is:inline>
        (function () {
          var btn = document.querySelector('[data-nav-toggle]');
          var drawer = document.querySelector('[data-nav-drawer]');
          if (!btn || !drawer) return;
          btn.addEventListener('click', function () {
            var open = drawer.hasAttribute('hidden') === false;
            if (open) {
              drawer.setAttribute('hidden', '');
              btn.setAttribute('aria-expanded', 'false');
              document.documentElement.classList.remove('nav-open');
            } else {
              drawer.removeAttribute('hidden');
              btn.setAttribute('aria-expanded', 'true');
              document.documentElement.classList.add('nav-open');
            }
          });
        })();
      </script>
    <!-- Adsterra Social Bar (friendly) — only ad on rea.run; placement 31654515 -->
    <script is:inline data-cfasync="false" src="https://bauval.org/14/99b962e54115827aad2e2528fdb8c8de"></script>
  </body>
</html>
