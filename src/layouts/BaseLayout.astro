---
import '../styles/global.css';
import { SITE, type Lang, pathFor, NAV } from '../lib/site';

interface Props {
  lang?: Lang;
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
}
const { lang = 'en', title, description, path, noindex = false } = Astro.props;
const canonicalPath = pathFor(lang, path);
const canonical = new URL(canonicalPath, SITE.url).href;
const enUrl = new URL(pathFor('en', path), SITE.url).href;
const zhUrl = new URL(pathFor('zh', path), SITE.url).href;
const otherLang = lang === 'en' ? 'zh' : 'en';
const otherHref = pathFor(otherLang, path);
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {SITE.gscVerification && <meta name="google-site-verification" content={SITE.gscVerification} />}
    {SITE.bingVerification && <meta name="msvalidate.01" content={SITE.bingVerification} />}
    {SITE.ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id: SITE.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', ga4Id);
        </script>
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600;700&family=Noto+Sans+SC:wght@400;500;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="site-shell min-h-screen flex flex-col">
    <header class="sticky top-0 z-40 border-b border-[var(--color-line)] bg-[color-mix(in_oklab,var(--color-void)_82%,transparent)] backdrop-blur-xl">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3.5">
        <a href={pathFor(lang, '/')} class="flex items-center gap-2.5 no-underline hover:no-underline">
          <span class="brand-mark">RE</span>
          <span class="text-[var(--color-ink)] font-semibold tracking-tight">rea.run</span>
        </a>
        <nav class="hidden items-center gap-5 md:flex">
          {NAV.map((item) => (
            <a
              href={pathFor(lang, item.href)}
              class:list={['nav-link', path === item.href && 'is-active']}
            >
              {lang === 'zh' ? item.labelZh : item.labelEn}
            </a>
          ))}
        </nav>
        <div class="flex items-center gap-2">
          <a href={SITE.upstreamRepo} class="btn-secondary !py-1.5 !px-3 !text-xs hidden sm:inline-flex">GitHub</a>
          <a href={otherHref} class="badge !normal-case !tracking-normal no-underline hover:no-underline" hreflang={otherLang === 'zh' ? 'zh-CN' : 'en'}>
            {otherLang === 'zh' ? '中文' : 'EN'}
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-20 border-t border-[var(--color-line)] bg-[var(--color-panel)]/80">
      <div class="mx-auto max-w-6xl px-4 py-12 text-sm text-[var(--color-muted)] space-y-4">
        <div class="flex items-center gap-2 text-[var(--color-ink)]">
          <span class="brand-mark">RE</span>
          <strong class="tracking-tight">rea.run</strong>
        </div>
        <p class="max-w-3xl leading-7">{lang === 'zh' ? SITE.disclaimerZh : SITE.disclaimer}</p>
        <p class="flex flex-wrap gap-x-5 gap-y-2">
          <a href={SITE.upstreamRepo}>{lang === 'zh' ? '上游仓库' : 'Upstream repo'}</a>
          <a href={SITE.upstreamNpm}>npm rea-agents</a>
          <a href={pathFor(lang, '/docs/install/')}>{lang === 'zh' ? '安装' : 'Install'}</a>
          <a href={pathFor(lang, '/verify/')}>{lang === 'zh' ? '搜索验证' : 'Search verify'}</a>
          <a href={pathFor(lang, '/compliance/')}>{lang === 'zh' ? '合规' : 'Compliance'}</a>
        </p>
        <p class="font-mono text-xs opacity-70">© {new Date().getFullYear()} rea.run community</p>
      </div>
    </footer>
  </body>
</html>
