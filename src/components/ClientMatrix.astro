---
import { CLIENTS_650, REA_PIN_VERSION } from '../data/clients65';

interface Props {
  lang?: 'en' | 'zh';
}
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
---
<div class="not-prose overflow-x-auto my-6">
  <table class="compare-table">
    <thead>
      <tr>
        <th>{zh ? '客户端' : 'Client'}</th>
        <th><code>--client</code></th>
        <th>{zh ? `${REA_PIN_VERSION} 接线` : `${REA_PIN_VERSION} wiring`}</th>
      </tr>
    </thead>
    <tbody>
      {CLIENTS_650.map((row) => (
        <tr>
          <td>{row.name}</td>
          <td><code>{row.id}</code></td>
          <td>{zh ? row.noteZh : row.noteEn}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
