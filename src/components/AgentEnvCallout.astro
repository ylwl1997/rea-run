---
import { AGENTENV } from '../data/environments';
import { pathFor, type Lang } from '../lib/site';

interface Props {
  lang?: Lang;
  /** compact for case detail pages */
  compact?: boolean;
}
const { lang = 'en', compact = false } = Astro.props;
const envsHref = pathFor(lang, '/environments/');
---
<section
  class:list={[
    'rounded-xl border border-[var(--color-line)] bg-[var(--color-panel)] p-4 sm:p-5',
    compact ? 'mt-10 text-sm' : 'mt-12',
  ]}
  aria-label={lang === 'zh' ? 'AgentEnv 提示' : 'AgentEnv callout'}
>
  <p class="kicker">{lang === 'zh' ? '下一步' : 'Next step'}</p>
  <h2 class:list={['mt-2 font-semibold text-[var(--color-ink)]', compact ? 'text-base' : 'text-lg']}>
    {lang === 'zh'
      ? '类似浏览器会话记录，可变成 AgentEnv 回放环境'
      : 'Similar browser session records can become AgentEnv replay environments'}
  </h2>
  <p class:list={['mt-2 text-[var(--color-muted)]', compact ? 'text-sm leading-6' : 'text-sm leading-7']}>
    {lang === 'zh' ? (
      <>
        本页案例<strong class="text-[var(--color-ink-soft)]">不是</strong>某个具体 HF 环境。REA 录下授权会话后，Scale AgentEnv 可把回放暴露为 MCP 工具。
        rea.run 只提供镜像目录，不托管运行时。
      </>
    ) : (
      <>
        This case is <strong class="text-[var(--color-ink-soft)]">not</strong> a claim that it is a specific Hugging Face environment.
        When REA records an authorized browser session, Scale AgentEnv can expose replay as MCP tools.
        rea.run mirrors the catalog only — we do not host the RL runtime.
      </>
    )}
  </p>
  <p class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
    <a href={envsHref}>{lang === 'zh' ? 'Environments 目录 →' : 'Environments catalog →'}</a>
    <a href={AGENTENV.collection} rel="noopener noreferrer" target="_blank">
      {lang === 'zh' ? 'HF 合集 ↗' : 'HF collection ↗'}
    </a>
    <a href={AGENTENV.blog} rel="noopener noreferrer" target="_blank">
      {lang === 'zh' ? 'AgentEnv 博客 ↗' : 'AgentEnv blog ↗'}
    </a>
  </p>
</section>
