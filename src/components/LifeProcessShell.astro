---
import { pathFor, type Lang } from '../lib/site';
interface Props {
  lang: Lang;
  active?: string;
}
const { lang, active = '' } = Astro.props;
const items = [
  { id: 'home', href: '/life-process/', en: 'Home', zh: '首页' },
  { id: 'about', href: '/life-process/about/', en: 'About', zh: '关于' },
  { id: 'modules', href: '/life-process/modules/', en: 'Modules', zh: '模块' },
  { id: 'rules', href: '/life-process/rules/', en: 'Rules', zh: '规则' },
  { id: 'stats', href: '/life-process/stats/', en: 'Stats', zh: '统计' },
  { id: 'join', href: '/life-process/join/', en: 'Join', zh: '参加' },
  { id: 'submissions', href: '/life-process/submissions/', en: 'Submissions', zh: '投稿' },
  { id: 'compare', href: '/life-process/compare/', en: 'Compare', zh: '对照' },
];
---
<div class="lp-shell">
  <div class="lp-compliance">
    {lang === 'zh' ? (
      <>仅公开可引用信号。禁止未授权访问／破解／exploit。详见 <a href={pathFor(lang, '/compliance/')}>合规</a>。</>
    ) : (
      <>Public citable signals only. No unauthorized access, crack, or exploit. See <a href={pathFor(lang, '/compliance/')}>compliance</a>.</>
    )}
  </div>
  <nav class="lp-subnav" aria-label={lang === 'zh' ? '生命进程' : 'Life Process'}>
    {items.map((item) => (
      <a
        href={pathFor(lang, item.href)}
        class:list={['lp-subnav-link', active === item.id && 'is-active']}
      >
        {lang === 'zh' ? item.zh : item.en}
      </a>
    ))}
  </nav>
  <div class="lp-body">
    <slot />
  </div>
</div>
